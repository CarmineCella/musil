{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(normalize\\-peak\\-stereo|spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-centroid|spectral\\-kurtosis|spectral\\-decrease|spectral\\-envelope|spectral\\-flatness|clear\\-sound\\-cache|synth\\-render\\-file|spectral\\-skewness|nmf\\-separate\\-with|linreg\\-residuals|flatten\\-spectrum|train\\-test\\-split|histogram\\-figure|schroeder\\-reverb|db\\-sounds\\-folder|kmeans\\-centroids|scatter\\-clusters|spectral\\-rolloff|layout\\-channels|stft\\-magnitudes|displayed\\-score|knn\\-predict\\-one|pca\\-eigenvalues|spectral\\-moment|spectral\\-spread|nmf\\-learn\\-parts|envelope\\-follow|onsets\\-adaptive|binaural\\-decode|play\\-score\\-from|nmf\\-spectrogram|instrument\\-rank|audio\\-init\\-with|impose\\-envelope|score\\-schedule|spectrum\\-freqs|spectral\\-morph|mat\\-print\\-with|pca\\-directions|max\\-re\\-weights|play\\-file\\-with|db\\-instruments|payload\\->event|linreg\\-predict|audio\\-channels|clear\\-controls|onset\\-strength|nmf\\-with\\-parts|register\\-score|score\\-duration|normalize\\-peak|onsets\\-of\\-flux|audio\\-running\\?|pca\\-explained|control\\-value|normalize\\-rms|controls\\-list|cluster\\-sizes|gate\\-spectrum|pvoc\\-formants|db\\-techniques|db\\-available\\?|median\\-filter|kmeans\\-labels|audio\\-devices|add\\-intercept|spectral\\-flux|score\\-remove!|note\\-duration|moving\\-source|starts\\-with\\?|assert\\-equal|pvoc\\-stretch|apply\\-filter|nmf\\-separate|count\\-substr|local\\-maxima|score\\-scale!|regex\\-match\\?|onset\\-refine|audio\\-report|score\\-events|render\\-event|princarg\\-deg|speaker\\-ring|score\\-shift!|synth\\-params|deinterleave|wav\\-duration|stereo\\-scale|bind\\-control|resolve\\-path|db\\-available|score\\-render|fit\\-duration|interactive\\?|audio\\-status|score\\-select|synth\\-render|plot\\-windows|assert\\-near|master\\-gain|ambi\\-encode|standardize|audio\\-start|play\\-buffer|spectrogram|resample\\-to|midi\\->pitch|add\\-surface|score\\-print|score\\-merge|ambi\\-decode|db\\-dynamics|append\\-file|ambi\\-render|fig\\-options|knn\\-predict|udp\\-receive|set\\-control|add\\-scatter|db\\-features|write\\-lines|score\\-sort!|event\\-lanes|dist\\-matrix|pan\\-azimuth|audio\\-close|concat\\-list|ambi\\-rotate|loop\\-buffer|nmf\\-sources|complex\\-mul|event\\-gain!|pitch\\->midi|add\\-subplot|linreg\\-fit|wait\\-until|play\\-synth|set\\-xrange|load\\-sound|directory\\?|osc\\-listen|arp\\-events|set\\-params|stereo\\-add|audio\\-init|db\\-nearest|hrir\\-model|interleave|x\\-or\\-index|db\\-pitches|pca\\-scores|streamable|ambi\\-gains|audio\\-stop|audio\\-time|play\\-score|set\\-yrange|osc\\-encode|file\\-lines|note\\->midi|set\\-labels|ends\\-with\\?|pat\\-events|db\\-between|trance\\-kit|score\\-roll|play\\-event|find\\-first|magnitudes|whisperize|pvoc\\-pitch|set\\-option|pvoc\\-cross|techno\\-kit|dc\\-block\\-r|instrument|audio\\-quit|plot\\-lines|fig\\-layers|csv\\-escape|audio\\-open|score\\-rows|live\\-loop|add\\-image|contains\\?|insert\\-at|hrtf\\-load|partition|set\\-param|mat\\-round|mat\\-zeros|mat\\-scale|histogram|voice\\-set|write\\-csv|write\\-wav|remove\\-at|file\\-size|play\\-with|extension|highshelf|mat\\-shape|mat\\-shift|map\\-range|transpose|next\\-pow2|sometimes|house\\-kit|col\\-stack|db\\-locate|playhead!|knn\\-model|fmt\\-fixed|list\\->mat|nmf\\-error|fig\\-title|mat\\-print|play\\-file|pad\\-right|event\\-end|add\\-layer|note\\-path|find\\-file|normalize|sort\\-list|lookahead|vec\\->list|cepstrum|blackman|bandpass|highpass|princarg|linspace|synth\\-ev|midi\\->hz|subplots|lowshelf|get\\-cols|osc\\-send|filename|add\\-bars|score\\-sr|read\\-csv|hadamard|group\\-by|udp\\-send|db\\-query|car\\->pol|save\\-png|identity|basename|defined\\?|pad\\-left|mat\\-ones|event\\-at|waveform|get\\-rows|quantile|mat\\-fill|set\\-rate|binaural|fftshift|free\\-all|rad\\->deg|fade\\-out|db\\-merge|resample|humanize|chord\\-ev|wait\\-for|spectrum|knn\\-test|hz\\->midi|accuracy|mat\\-mean|sequence|pol\\->car|note\\-off|robotize|mat\\-rand|autocorr|read\\-wav|dc\\-block|ev\\-thunk|supersaw|segments|audio\\-sr|mat\\-diag|db\\-range|ambi\\-add|deg\\->rad|add\\-line|between\\?|peak\\-eq|mat\\-map|note\\-at|db\\-make|surface|scatter|mat\\-row|compose|lp\\-norm|mat\\-add|add\\-at!|mat\\-std|play\\-at|mat\\-set|ev\\-beat|mat\\-get|sort\\-by|accents|interp1|mat\\-mul|flatten|hamming|fade\\-in|fn\\-name|fmt\\-pct|plot\\-xy|mat\\-max|set\\-pan|db\\-size|shuffle|degrade|db\\-path|replace|reverse|mat\\-sub|denoise|db\\-read|mat\\-str|nearest|mat\\-min|lowpass|display|control|linefit|oscbank|set\\-amp|mat\\-col|db\\-load|mat\\-div|impulse|play\\-ev|elapsed|offbass|db\\-find|vec\\-mat|exists\\?|mat\\-vec|db\\-grep|note\\-on|dirname|mat\\-sum|channel|to\\-rate|eig\\-sym|hstack|min\\-of|min\\-by|dist\\-p|getenv|rumble|hoover|equal\\?|remove|onsets|argmax|acf\\-f0|voices|reduce|append|kmeans|add\\-at|synths|setidx|max\\-of|euclid|window|sum\\-by|center|unique|reject|max\\-by|gather|phases|repeat|median|empty\\?|zscore|db\\-gen|filter|length|vstack|argmin|figure|concat|assert|cumsum|biquad|format|chance|melody|record|values|render|getidx|ev\\-dur|place|atan2|shift|sleep|times|even\\?|riser|tstab|write|istft|split|reson|tclap|nrows|outer|chord|print|input|sweep|lower|gater|parse|zeros|file\\?|round|error|score|tempo|ncols|fixed|trace|every|stack|synth|noise|snare|image|stdev|solve|steps|serve|hypot|event|clock|count|upper|tohat|delay|log10|pluck|pan\\-n|range|slice|drums|tkick|mkdir|swing|floor|notch|ceil|roll|free|undb|type|norm|put!|plot|stat|find|that|rank|adsr|sign|head|ohat|ramp|poly|acos|hpss|stab|acid|copy|note|asin|kick|all\\?|pvoc|perc|diag|has\\?|clap|keys|play|push|prod|diff|stft|clip|take|dist|list|read|tpad|hann|call|sort|corr|comb|show|join|sqrt|fast|rand|last|exec|conv|duck|vars|beat|bars|trim|drop|hrir|sine|ifft|lerp|ones|tanh|odd\\?|dir\\?|each|log2|atan|tail|stop|exit|mean|seed|any\\?|dot|pad|get|gcd|lcm|chr|mix|zip|det|vec|nmf|log|tan|num|cat|lag|hat|eye|rev|hfc|knn|zap|gen|min|ord|osc|inv|zcr|iir|cos|map|bpf|exp|sym|fft|sig|sub|pow|pop|mod|sum|arp|pan|opt|str|abs|sin|max|pat|rms|now|pca|cov|cwd|put|db|ev|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

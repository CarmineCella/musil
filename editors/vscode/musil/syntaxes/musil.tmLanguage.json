{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|synth\\-render\\-file|spectral\\-flatness|spectral\\-kurtosis|spectral\\-skewness|spectral\\-decrease|spectral\\-centroid|spectral\\-envelope|kmeans\\-centroids|histogram\\-figure|flatten\\-spectrum|train\\-test\\-split|scatter\\-clusters|spectral\\-rolloff|linreg\\-residuals|schroeder\\-reverb|pca\\-eigenvalues|spectral\\-moment|impose\\-envelope|audio\\-init\\-with|spectral\\-spread|envelope\\-follow|stft\\-magnitudes|knn\\-predict\\-one|normalize\\-peak|audio\\-running\\?|clear\\-controls|play\\-file\\-with|spectral\\-morph|audio\\-channels|linreg\\-predict|pca\\-directions|mat\\-print\\-with|spectrum\\-freqs|pvoc\\-formants|audio\\-devices|kmeans\\-labels|spectral\\-flux|controls\\-list|pca\\-explained|cluster\\-sizes|control\\-value|gate\\-spectrum|normalize\\-rms|add\\-intercept|median\\-filter|synth\\-params|assert\\-equal|local\\-maxima|starts\\-with\\?|apply\\-filter|deinterleave|plot\\-windows|count\\-substr|pvoc\\-stretch|audio\\-status|bind\\-control|synth\\-render|audio\\-report|wav\\-duration|audio\\-start|audio\\-close|master\\-gain|spectrogram|fig\\-options|udp\\-receive|play\\-buffer|complex\\-mul|knn\\-predict|add\\-subplot|write\\-lines|resample\\-to|standardize|add\\-surface|loop\\-buffer|assert\\-near|append\\-file|dist\\-matrix|concat\\-list|set\\-control|add\\-scatter|audio\\-open|set\\-xrange|streamable|play\\-synth|osc\\-listen|set\\-labels|x\\-or\\-index|audio\\-time|pvoc\\-cross|file\\-lines|set\\-params|osc\\-encode|csv\\-escape|fig\\-layers|audio\\-stop|plot\\-lines|ends\\-with\\?|linreg\\-fit|pca\\-scores|pvoc\\-pitch|wait\\-until|magnitudes|interleave|whisperize|set\\-option|set\\-yrange|dc\\-block\\-r|audio\\-init|audio\\-quit|mat\\-print|col\\-stack|write\\-wav|fig\\-title|mat\\-scale|lookahead|find\\-file|add\\-image|mat\\-shift|highshelf|vec\\->list|mat\\-round|mat\\-zeros|list\\->mat|knn\\-model|write\\-csv|play\\-file|fmt\\-fixed|live\\-loop|histogram|extension|file\\-size|pad\\-right|sort\\-list|map\\-range|voice\\-set|mat\\-shape|contains\\?|add\\-layer|next\\-pow2|set\\-param|play\\-with|normalize|transpose|add\\-line|waveform|mat\\-diag|autocorr|blackman|knn\\-test|resample|princarg|between\\?|dc\\-block|pad\\-left|get\\-cols|synth\\-ev|add\\-bars|get\\-rows|deg\\->rad|bandpass|basename|free\\-all|quantile|highpass|spectrum|read\\-csv|wait\\-for|fade\\-out|linspace|pol\\->car|defined\\?|mat\\-fill|cepstrum|mat\\-rand|read\\-wav|lowshelf|udp\\-send|hadamard|sequence|save\\-png|note\\-off|car\\->pol|osc\\-send|set\\-rate|identity|robotize|accuracy|fftshift|mat\\-ones|rad\\->deg|ev\\-thunk|audio\\-sr|subplots|mat\\-mean|hamming|mat\\-get|mat\\-row|nearest|oscbank|surface|mat\\-mul|play\\-at|fade\\-in|control|replace|denoise|interp1|fmt\\-pct|mat\\-sub|note\\-on|peak\\-eq|set\\-pan|reverse|mat\\-set|lp\\-norm|eig\\-sym|mat\\-map|compose|set\\-amp|mat\\-sum|elapsed|impulse|play\\-ev|mat\\-str|note\\-at|add\\-at!|mat\\-std|degrade|mat\\-col|mat\\-add|mat\\-vec|vec\\-mat|exists\\?|dirname|linefit|flatten|shuffle|ev\\-beat|plot\\-xy|lowpass|scatter|format|synths|median|filter|append|equal\\?|ev\\-dur|voices|concat|acf\\-f0|unique|cumsum|repeat|hstack|window|zscore|length|remove|getidx|center|gather|max\\-of|kmeans|setidx|argmin|min\\-of|biquad|figure|argmax|vstack|getenv|assert|empty\\?|add\\-at|dist\\-p|reduce|phases|every|delay|floor|sleep|ncols|times|hypot|synth|round|outer|split|stdev|steps|stack|atan2|input|print|trace|noise|clock|log10|slice|nrows|range|count|error|tempo|file\\?|even\\?|zeros|fixed|shift|solve|reson|mkdir|upper|notch|lower|image|write|istft|beat|push|read|note|sqrt|rank|corr|find|sort|clip|diag|odd\\?|type|undb|all\\?|trim|plot|bars|exit|stop|stat|show|hann|adsr|dist|ifft|join|last|fast|list|head|sign|dir\\?|cons|conv|exec|free|lerp|prod|ceil|asin|mean|rand|take|each|diff|any\\?|tail|drop|ones|play|log2|pvoc|comb|vars|ramp|acos|seed|sine|stft|atan|copy|norm|exp|inv|abs|iir|min|sin|osc|knn|cwd|sum|vec|rms|now|ord|bpf|pan|str|gcd|eye|sym|chr|opt|cov|rev|det|log|lag|zip|tan|map|cat|mod|lcm|cos|mix|dot|num|hfc|pca|gen|pow|zcr|fft|pop|max|db|ev|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

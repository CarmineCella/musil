{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(normalize\\-peak\\-stereo|spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-flatness|spectral\\-skewness|nmf\\-separate\\-with|spectral\\-envelope|clear\\-sound\\-cache|spectral\\-kurtosis|spectral\\-centroid|synth\\-render\\-file|spectral\\-decrease|linreg\\-residuals|train\\-test\\-split|flatten\\-spectrum|db\\-sounds\\-folder|kmeans\\-centroids|scatter\\-clusters|spectral\\-rolloff|histogram\\-figure|schroeder\\-reverb|audio\\-init\\-with|play\\-score\\-from|binaural\\-decode|layout\\-channels|nmf\\-spectrogram|instrument\\-rank|impose\\-envelope|spectral\\-moment|knn\\-predict\\-one|onsets\\-adaptive|stft\\-magnitudes|spectral\\-spread|pca\\-eigenvalues|nmf\\-learn\\-parts|envelope\\-follow|clear\\-controls|spectral\\-morph|play\\-file\\-with|score\\-schedule|audio\\-running\\?|onsets\\-of\\-flux|nmf\\-with\\-parts|payload\\->event|pca\\-directions|spectrum\\-freqs|max\\-re\\-weights|audio\\-channels|mat\\-print\\-with|onset\\-strength|db\\-instruments|linreg\\-predict|score\\-duration|normalize\\-peak|moving\\-source|control\\-value|median\\-filter|cluster\\-sizes|db\\-available\\?|note\\-duration|add\\-intercept|score\\-remove!|normalize\\-rms|kmeans\\-labels|controls\\-list|pca\\-explained|gate\\-spectrum|db\\-techniques|audio\\-devices|spectral\\-flux|pvoc\\-formants|assert\\-equal|render\\-event|score\\-shift!|synth\\-render|onset\\-refine|synth\\-params|bind\\-control|princarg\\-deg|plot\\-windows|db\\-available|score\\-events|score\\-scale!|audio\\-status|audio\\-report|score\\-render|starts\\-with\\?|wav\\-duration|fit\\-duration|score\\-select|resolve\\-path|nmf\\-separate|pvoc\\-stretch|apply\\-filter|score\\-export|deinterleave|interactive\\?|stereo\\-scale|local\\-maxima|count\\-substr|speaker\\-ring|regex\\-match\\?|score\\-print|append\\-file|fig\\-options|knn\\-predict|audio\\-start|add\\-surface|score\\-merge|udp\\-receive|spectrogram|event\\-lanes|db\\-dynamics|play\\-buffer|dist\\-matrix|score\\-sort!|complex\\-mul|write\\-lines|add\\-scatter|ambi\\-rotate|pan\\-azimuth|ambi\\-render|event\\-gain!|audio\\-close|resample\\-to|db\\-features|add\\-subplot|midi\\->pitch|assert\\-near|standardize|ambi\\-decode|set\\-control|loop\\-buffer|master\\-gain|nmf\\-sources|ambi\\-encode|pitch\\->midi|concat\\-list|audio\\-open|directory\\?|dc\\-block\\-r|audio\\-time|arp\\-events|set\\-option|pvoc\\-pitch|hrir\\-model|trance\\-kit|pvoc\\-cross|plot\\-lines|play\\-synth|magnitudes|ambi\\-gains|csv\\-escape|stereo\\-add|osc\\-listen|osc\\-encode|db\\-pitches|audio\\-quit|db\\-between|streamable|fig\\-layers|pca\\-scores|interleave|audio\\-init|set\\-yrange|whisperize|play\\-score|set\\-params|ends\\-with\\?|score\\-rows|linreg\\-fit|set\\-labels|x\\-or\\-index|db\\-nearest|pat\\-events|score\\-roll|techno\\-kit|note\\->midi|set\\-xrange|file\\-lines|wait\\-until|load\\-sound|instrument|audio\\-stop|find\\-first|write\\-csv|mat\\-scale|mat\\-zeros|add\\-layer|remove\\-at|event\\-end|add\\-image|file\\-size|sometimes|fig\\-title|lookahead|mat\\-print|normalize|col\\-stack|mat\\-round|insert\\-at|list\\->mat|nmf\\-error|mat\\-shape|fmt\\-fixed|play\\-file|mat\\-shift|voice\\-set|pad\\-right|hrtf\\-load|note\\-path|to\\-source|play\\-with|histogram|next\\-pow2|write\\-wav|transpose|live\\-loop|extension|highshelf|find\\-file|vec\\->list|contains\\?|db\\-locate|knn\\-model|map\\-range|sort\\-list|partition|set\\-param|house\\-kit|spectrum|free\\-all|get\\-rows|db\\-query|get\\-cols|knn\\-test|audio\\-sr|add\\-bars|db\\-range|group\\-by|blackman|hadamard|highpass|rad\\->deg|db\\-merge|defined\\?|resample|waveform|mat\\-rand|read\\-csv|segments|supersaw|mat\\-fill|binaural|autocorr|basename|cepstrum|linspace|wait\\-for|mat\\-mean|car\\->pol|between\\?|score\\-sr|accuracy|quantile|save\\-png|note\\-off|read\\-wav|filename|humanize|hz\\->midi|midi\\->hz|set\\-rate|deg\\->rad|dc\\-block|lowshelf|chord\\-ev|osc\\-send|add\\-line|princarg|fade\\-out|udp\\-send|fftshift|pol\\->car|mat\\-ones|pad\\-left|sequence|identity|ev\\-thunk|bandpass|event\\-at|synth\\-ev|subplots|robotize|ambi\\-add|mat\\-diag|mat\\-vec|db\\-read|db\\-load|vec\\-mat|fn\\-name|elapsed|shuffle|flatten|mat\\-get|sort\\-by|play\\-ev|channel|compose|play\\-at|linefit|dirname|set\\-pan|db\\-find|note\\-at|control|mat\\-min|offbass|scatter|mat\\-mul|mat\\-col|surface|degrade|mat\\-row|ev\\-beat|hamming|peak\\-eq|mat\\-str|mat\\-div|lowpass|nearest|mat\\-set|replace|mat\\-sub|db\\-path|note\\-on|db\\-grep|mat\\-std|exists\\?|db\\-size|mat\\-add|to\\-rate|eig\\-sym|add\\-at!|mat\\-max|mat\\-map|mat\\-sum|impulse|display|fade\\-in|plot\\-xy|set\\-amp|fmt\\-pct|interp1|accents|lp\\-norm|oscbank|denoise|db\\-make|reverse|max\\-of|min\\-by|assert|getenv|synths|biquad|euclid|melody|reduce|zscore|values|dist\\-p|equal\\?|filter|cumsum|render|db\\-key|setidx|sum\\-by|median|db\\-gen|hstack|chance|acf\\-f0|record|hoover|figure|repeat|getidx|reject|gather|unique|vstack|rumble|remove|max\\-by|append|ev\\-dur|length|concat|voices|center|add\\-at|window|kmeans|argmax|format|min\\-of|onsets|phases|argmin|empty\\?|solve|place|shift|file\\?|image|chord|nrows|tohat|pluck|tkick|zeros|riser|noise|sweep|log10|synth|trace|slice|floor|swing|drums|fixed|mkdir|tempo|sleep|istft|upper|pan\\-n|outer|error|reson|every|steps|count|atan2|delay|snare|tstab|write|round|serve|stdev|lower|split|parse|times|ncols|clock|even\\?|tclap|notch|event|score|stack|gater|range|print|input|hypot|stop|drop|comb|all\\?|diff|seed|stat|acid|take|read|sqrt|ifft|plot|show|undb|bars|type|exit|sort|ramp|tpad|hann|tanh|asin|mean|trim|adsr|call|last|conv|ones|ohat|push|dir\\?|clap|roll|corr|clip|perc|that|has\\?|head|join|stft|hrir|kick|exec|note|dist|sine|free|lerp|stab|poly|log2|any\\?|odd\\?|copy|play|fast|norm|rank|list|tail|vars|acos|diag|atan|rand|pvoc|sign|prod|hpss|find|put!|keys|beat|ceil|each|duck|rms|lcm|opt|ord|lag|get|bpf|sig|mod|sin|tan|det|mix|cat|nmf|iir|dot|arp|zap|sum|osc|hat|pat|chr|sym|gcd|rev|pca|eye|cov|exp|sub|min|now|log|fft|gen|max|knn|pad|cos|cwd|zip|map|inv|pan|pop|str|pow|hfc|num|put|abs|vec|zcr|ls|db|ev)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

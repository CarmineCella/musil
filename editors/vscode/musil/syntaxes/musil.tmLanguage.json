{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-envelope|spectral\\-centroid|spectral\\-decrease|spectral\\-flatness|synth\\-render\\-file|spectral\\-skewness|spectral\\-kurtosis|histogram\\-figure|schroeder\\-reverb|linreg\\-residuals|flatten\\-spectrum|train\\-test\\-split|scatter\\-clusters|kmeans\\-centroids|spectral\\-rolloff|pca\\-eigenvalues|spectral\\-spread|envelope\\-follow|spectral\\-moment|knn\\-predict\\-one|impose\\-envelope|stft\\-magnitudes|audio\\-init\\-with|normalize\\-peak|pca\\-directions|clear\\-controls|spectral\\-morph|mat\\-print\\-with|spectrum\\-freqs|play\\-file\\-with|audio\\-channels|linreg\\-predict|audio\\-running\\?|normalize\\-rms|add\\-intercept|spectral\\-flux|pvoc\\-formants|kmeans\\-labels|control\\-value|audio\\-devices|controls\\-list|pca\\-explained|median\\-filter|gate\\-spectrum|cluster\\-sizes|apply\\-filter|synth\\-params|starts\\-with\\?|bind\\-control|deinterleave|audio\\-status|pvoc\\-stretch|assert\\-equal|plot\\-windows|wav\\-duration|count\\-substr|audio\\-report|synth\\-render|local\\-maxima|spectrogram|append\\-file|audio\\-close|master\\-gain|dist\\-matrix|complex\\-mul|audio\\-start|standardize|resample\\-to|set\\-control|concat\\-list|knn\\-predict|add\\-subplot|add\\-surface|fig\\-options|play\\-buffer|loop\\-buffer|udp\\-receive|assert\\-near|add\\-scatter|write\\-lines|audio\\-stop|dc\\-block\\-r|set\\-labels|whisperize|fig\\-layers|audio\\-quit|linreg\\-fit|play\\-synth|set\\-yrange|osc\\-encode|audio\\-open|interleave|csv\\-escape|osc\\-listen|plot\\-lines|audio\\-time|ends\\-with\\?|x\\-or\\-index|set\\-params|wait\\-until|file\\-lines|audio\\-init|streamable|set\\-option|pvoc\\-pitch|set\\-xrange|pvoc\\-cross|magnitudes|pca\\-scores|list\\->mat|knn\\-model|lookahead|mat\\-shape|fmt\\-fixed|mat\\-scale|voice\\-set|contains\\?|next\\-pow2|pad\\-right|fig\\-title|write\\-csv|mat\\-round|play\\-file|histogram|highshelf|mat\\-zeros|play\\-with|extension|sort\\-list|vec\\->list|live\\-loop|mat\\-print|set\\-param|mat\\-shift|transpose|col\\-stack|add\\-image|find\\-file|file\\-size|normalize|add\\-layer|map\\-range|write\\-wav|dc\\-block|get\\-rows|read\\-csv|ev\\-thunk|sequence|free\\-all|mat\\-ones|rad\\->deg|fftshift|subplots|mat\\-fill|osc\\-send|save\\-png|between\\?|add\\-bars|synth\\-ev|defined\\?|pol\\->car|add\\-line|audio\\-sr|autocorr|quantile|linspace|bandpass|mat\\-mean|knn\\-test|mat\\-rand|blackman|highpass|robotize|princarg|set\\-rate|mat\\-diag|car\\->pol|pad\\-left|hadamard|accuracy|read\\-wav|note\\-off|spectrum|deg\\->rad|cepstrum|wait\\-for|lowshelf|udp\\-send|fade\\-out|get\\-cols|resample|waveform|identity|basename|ev\\-beat|mat\\-std|mat\\-row|mat\\-get|add\\-at!|plot\\-xy|scatter|control|dirname|peak\\-eq|set\\-amp|nearest|mat\\-col|impulse|hamming|vec\\-mat|lp\\-norm|play\\-ev|mat\\-set|fmt\\-pct|note\\-on|replace|mat\\-str|shuffle|mat\\-sum|oscbank|mat\\-sub|set\\-pan|lowpass|note\\-at|eig\\-sym|flatten|mat\\-add|play\\-at|denoise|reverse|surface|elapsed|compose|exists\\?|interp1|fade\\-in|linefit|mat\\-mul|degrade|mat\\-vec|mat\\-map|acf\\-f0|argmax|concat|argmin|setidx|remove|repeat|filter|equal\\?|dist\\-p|min\\-of|synths|getenv|unique|center|voices|assert|append|empty\\?|window|hstack|format|phases|zscore|kmeans|getidx|ev\\-dur|gather|length|max\\-of|biquad|cumsum|add\\-at|vstack|median|figure|reduce|image|delay|solve|input|slice|times|noise|atan2|even\\?|fixed|range|file\\?|ncols|sleep|tempo|istft|error|synth|notch|stack|print|nrows|floor|lower|trace|zeros|steps|log10|clock|upper|write|outer|stdev|split|mkdir|shift|every|hypot|round|reson|count|ceil|beat|atan|play|ifft|copy|ramp|stop|sign|diff|exit|sqrt|find|clip|mean|all\\?|push|conv|lerp|rand|plot|prod|corr|read|trim|norm|dir\\?|asin|comb|log2|stft|dist|any\\?|head|undb|type|stat|diag|acos|note|seed|join|tail|last|fast|sort|exec|pvoc|cons|free|ones|show|adsr|hann|each|rank|odd\\?|sine|drop|bars|list|vars|take|map|lag|sin|exp|knn|mix|pan|now|mod|hfc|sym|det|cat|rev|lcm|str|sum|gcd|pca|dot|gen|max|eye|tan|pow|cos|log|opt|zip|fft|inv|vec|pop|osc|ord|zcr|abs|cwd|cov|iir|num|chr|min|bpf|rms|ev|ls|db)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

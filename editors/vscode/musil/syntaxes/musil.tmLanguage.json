{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|pvoc\\-pitch\\-formant|magnitude\\-spectrum|spectral\\-centroid|spectral\\-envelope|spectral\\-decrease|spectral\\-flatness|spectral\\-skewness|synth\\-render\\-file|spectral\\-kurtosis|scatter\\-clusters|linreg\\-residuals|kmeans\\-centroids|flatten\\-spectrum|spectral\\-rolloff|histogram\\-figure|schroeder\\-reverb|train\\-test\\-split|stft\\-magnitudes|audio\\-init\\-with|envelope\\-follow|knn\\-predict\\-one|impose\\-envelope|spectral\\-moment|spectral\\-spread|pca\\-eigenvalues|spectral\\-morph|pca\\-directions|audio\\-channels|play\\-file\\-with|normalize\\-peak|audio\\-running\\?|clear\\-controls|linreg\\-predict|mat\\-print\\-with|spectrum\\-freqs|audio\\-devices|gate\\-spectrum|pca\\-explained|control\\-value|controls\\-list|normalize\\-rms|median\\-filter|cluster\\-sizes|spectral\\-flux|pvoc\\-formants|add\\-intercept|kmeans\\-labels|audio\\-status|plot\\-windows|deinterleave|apply\\-filter|audio\\-report|bind\\-control|synth\\-render|pvoc\\-stretch|starts\\-with\\?|synth\\-params|wav\\-duration|count\\-substr|local\\-maxima|assert\\-equal|dist\\-matrix|master\\-gain|write\\-lines|spectrogram|loop\\-buffer|add\\-scatter|resample\\-to|complex\\-mul|play\\-buffer|set\\-control|standardize|fig\\-options|add\\-subplot|audio\\-start|audio\\-close|assert\\-near|append\\-file|udp\\-receive|concat\\-list|knn\\-predict|add\\-surface|interleave|streamable|x\\-or\\-index|osc\\-encode|pca\\-scores|audio\\-init|ends\\-with\\?|audio\\-open|set\\-labels|set\\-xrange|set\\-option|set\\-params|fig\\-layers|audio\\-time|set\\-yrange|plot\\-lines|audio\\-quit|whisperize|file\\-lines|magnitudes|osc\\-listen|csv\\-escape|pvoc\\-cross|dc\\-block\\-r|pvoc\\-pitch|audio\\-stop|play\\-synth|linreg\\-fit|wait\\-until|live\\-loop|find\\-file|knn\\-model|histogram|fmt\\-fixed|add\\-image|mat\\-scale|extension|map\\-range|mat\\-zeros|mat\\-shape|lookahead|highshelf|pad\\-right|sort\\-list|list\\->mat|mat\\-shift|contains\\?|normalize|play\\-with|file\\-size|set\\-param|col\\-stack|write\\-csv|fig\\-title|next\\-pow2|mat\\-print|mat\\-round|play\\-file|vec\\->list|voice\\-set|add\\-layer|write\\-wav|transpose|bandpass|get\\-rows|read\\-wav|identity|car\\->pol|mat\\-diag|princarg|free\\-all|subplots|get\\-cols|dc\\-block|audio\\-sr|knn\\-test|pol\\->car|fftshift|save\\-png|mat\\-ones|synth\\-ev|linspace|hadamard|pad\\-left|read\\-csv|deg\\->rad|resample|accuracy|mat\\-mean|defined\\?|sequence|add\\-line|mat\\-rand|wait\\-for|basename|lowshelf|rad\\->deg|osc\\-send|spectrum|note\\-off|robotize|highpass|ev\\-thunk|waveform|quantile|fade\\-out|cepstrum|autocorr|blackman|between\\?|add\\-bars|mat\\-fill|set\\-rate|udp\\-send|degrade|note\\-at|flatten|impulse|mat\\-std|peak\\-eq|lp\\-norm|mat\\-sub|dirname|mat\\-vec|plot\\-xy|mat\\-map|reverse|shuffle|set\\-amp|fade\\-in|ev\\-beat|denoise|set\\-pan|lowpass|oscbank|mat\\-col|mat\\-set|mat\\-str|linefit|surface|scatter|fmt\\-pct|elapsed|vec\\-mat|mat\\-add|mat\\-sum|mat\\-mul|replace|add\\-at!|compose|mat\\-row|nearest|eig\\-sym|note\\-on|play\\-at|control|interp1|play\\-ev|mat\\-get|exists\\?|hamming|equal\\?|phases|argmax|kmeans|reduce|biquad|min\\-of|gather|hstack|setidx|getenv|median|argmin|center|acf\\-f0|ev\\-dur|filter|concat|vstack|assert|max\\-of|repeat|remove|length|getidx|synths|append|figure|unique|cumsum|zscore|voices|format|add\\-at|empty\\?|dist\\-p|window|every|synth|write|print|lower|log10|file\\?|zeros|sleep|times|istft|range|floor|outer|stdev|image|delay|ncols|shift|tempo|solve|trace|nrows|reson|stack|notch|even\\?|clock|slice|noise|count|upper|input|atan2|hypot|steps|error|fixed|round|mkdir|split|ramp|asin|ones|take|tail|sign|fast|sqrt|stat|play|norm|trim|head|prod|stop|last|log2|stft|sine|mean|ifft|any\\?|free|exec|join|seed|corr|note|read|acos|lerp|diff|each|diag|rank|clip|hann|copy|adsr|plot|odd\\?|list|exit|comb|type|cons|find|undb|show|all\\?|push|conv|beat|ceil|pvoc|bars|sort|dist|rand|atan|dir\\?|drop|vars|pow|num|osc|hfc|lag|iir|pca|rms|lcm|vec|mod|rev|ord|eye|cwd|abs|str|cov|exp|now|log|det|knn|sym|zip|opt|pop|tan|zcr|bpf|gcd|min|inv|sum|fft|chr|map|sin|pan|max|mix|dot|gen|cat|cos|ev|db|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

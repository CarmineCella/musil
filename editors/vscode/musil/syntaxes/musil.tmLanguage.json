{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|normalize\\-peak\\-stereo|envelope\\-from\\-values|pvoc\\-pitch\\-formant|magnitude\\-spectrum|nmf\\-separate\\-with|synth\\-render\\-file|spectral\\-kurtosis|spectral\\-decrease|spectral\\-flatness|spectral\\-centroid|spectral\\-skewness|spectral\\-envelope|schroeder\\-reverb|spectral\\-rolloff|histogram\\-figure|flatten\\-spectrum|train\\-test\\-split|kmeans\\-centroids|linreg\\-residuals|scatter\\-clusters|audio\\-init\\-with|envelope\\-follow|nmf\\-learn\\-parts|knn\\-predict\\-one|stft\\-magnitudes|nmf\\-spectrogram|spectral\\-moment|impose\\-envelope|pca\\-eigenvalues|binaural\\-decode|onsets\\-adaptive|spectral\\-spread|audio\\-running\\?|max\\-re\\-weights|pca\\-directions|normalize\\-peak|mat\\-print\\-with|play\\-file\\-with|linreg\\-predict|clear\\-controls|onsets\\-of\\-flux|audio\\-channels|nmf\\-with\\-parts|spectral\\-morph|spectrum\\-freqs|onset\\-strength|cluster\\-sizes|add\\-intercept|control\\-value|median\\-filter|pvoc\\-formants|kmeans\\-labels|controls\\-list|gate\\-spectrum|audio\\-devices|moving\\-source|spectral\\-flux|pca\\-explained|normalize\\-rms|starts\\-with\\?|stereo\\-scale|pvoc\\-stretch|nmf\\-separate|onset\\-refine|princarg\\-deg|plot\\-windows|speaker\\-ring|synth\\-params|apply\\-filter|audio\\-status|bind\\-control|local\\-maxima|interactive\\?|deinterleave|wav\\-duration|audio\\-report|assert\\-equal|synth\\-render|count\\-substr|audio\\-start|nmf\\-sources|spectrogram|dist\\-matrix|assert\\-near|ambi\\-render|master\\-gain|add\\-scatter|add\\-subplot|ambi\\-rotate|resample\\-to|write\\-lines|loop\\-buffer|append\\-file|concat\\-list|standardize|pan\\-azimuth|play\\-buffer|ambi\\-decode|set\\-control|fig\\-options|audio\\-close|knn\\-predict|complex\\-mul|ambi\\-encode|udp\\-receive|add\\-surface|audio\\-init|set\\-xrange|stereo\\-add|audio\\-quit|audio\\-open|plot\\-lines|magnitudes|ends\\-with\\?|find\\-first|osc\\-listen|x\\-or\\-index|pvoc\\-pitch|dc\\-block\\-r|linreg\\-fit|set\\-params|ambi\\-gains|hrir\\-model|csv\\-escape|set\\-yrange|wait\\-until|interleave|set\\-option|audio\\-time|pvoc\\-cross|play\\-synth|trance\\-kit|note\\->midi|osc\\-encode|arp\\-events|techno\\-kit|pca\\-scores|audio\\-stop|whisperize|pat\\-events|streamable|fig\\-layers|set\\-labels|file\\-lines|pad\\-right|mat\\-round|write\\-csv|write\\-wav|next\\-pow2|lookahead|list\\->mat|highshelf|fmt\\-fixed|mat\\-scale|sometimes|vec\\->list|transpose|insert\\-at|sort\\-list|play\\-file|extension|mat\\-shape|voice\\-set|remove\\-at|file\\-size|play\\-with|mat\\-zeros|fig\\-title|contains\\?|partition|find\\-file|add\\-layer|house\\-kit|add\\-image|mat\\-shift|mat\\-print|normalize|hrtf\\-load|live\\-loop|knn\\-model|nmf\\-error|map\\-range|histogram|set\\-param|col\\-stack|hz\\->midi|fftshift|note\\-off|highpass|linspace|fade\\-out|wait\\-for|set\\-rate|segments|blackman|deg\\->rad|free\\-all|quantile|audio\\-sr|mat\\-rand|mat\\-mean|lowshelf|cepstrum|dc\\-block|udp\\-send|bandpass|rad\\->deg|basename|car\\->pol|synth\\-ev|pad\\-left|resample|ambi\\-add|save\\-png|humanize|get\\-rows|mat\\-ones|pol\\->car|princarg|binaural|supersaw|get\\-cols|mat\\-diag|read\\-wav|autocorr|accuracy|osc\\-send|identity|group\\-by|defined\\?|robotize|midi\\->hz|spectrum|between\\?|add\\-line|hadamard|ev\\-thunk|chord\\-ev|subplots|waveform|mat\\-fill|add\\-bars|knn\\-test|read\\-csv|sequence|play\\-ev|add\\-at!|replace|linefit|nearest|flatten|play\\-at|vec\\-mat|eig\\-sym|channel|hamming|mat\\-mul|lp\\-norm|impulse|mat\\-set|control|elapsed|mat\\-max|set\\-amp|mat\\-min|compose|degrade|denoise|exists\\?|mat\\-add|lowpass|mat\\-get|surface|mat\\-sub|note\\-at|scatter|mat\\-div|set\\-pan|fade\\-in|mat\\-str|mat\\-map|ev\\-beat|shuffle|mat\\-vec|oscbank|mat\\-col|reverse|offbass|mat\\-row|fmt\\-pct|interp1|dirname|peak\\-eq|note\\-on|sort\\-by|accents|mat\\-std|mat\\-sum|plot\\-xy|kmeans|max\\-by|sum\\-by|euclid|cumsum|dist\\-p|acf\\-f0|zscore|synths|gather|unique|filter|hstack|reject|rumble|hoover|window|record|equal\\?|getidx|setidx|argmax|format|concat|argmin|assert|reduce|onsets|add\\-at|ev\\-dur|repeat|max\\-of|append|biquad|min\\-by|center|remove|values|empty\\?|phases|length|getenv|chance|vstack|median|min\\-of|figure|voices|melody|mkdir|clock|chord|istft|even\\?|tkick|file\\?|trace|gater|sleep|drums|synth|ncols|solve|print|zeros|every|shift|atan2|parse|delay|error|tohat|stack|lower|floor|tempo|nrows|reson|write|snare|tclap|swing|stdev|round|steps|upper|outer|count|notch|noise|sweep|hypot|tstab|slice|serve|image|fixed|pluck|times|log10|range|pan\\-n|riser|split|input|mean|take|ceil|comb|adsr|list|drop|hrir|pvoc|dist|duck|last|roll|head|free|kick|ones|sign|rand|join|clap|all\\?|beat|stat|corr|dir\\?|log2|atan|type|diag|acos|find|trim|asin|norm|keys|sort|diff|exit|has\\?|sqrt|conv|ramp|rank|perc|ohat|that|seed|clip|lerp|hpss|read|odd\\?|sine|note|plot|tanh|hann|bars|tpad|stab|each|undb|fast|any\\?|tail|ifft|exec|stft|prod|play|put!|push|copy|stop|show|poly|acid|vars|osc|pan|gcd|str|cov|zap|gen|arp|sum|abs|rms|cos|hfc|lag|lcm|knn|max|dot|eye|num|sym|opt|sin|cwd|pca|mix|sub|inv|cat|min|get|exp|bpf|pow|vec|ord|zcr|pad|chr|put|log|det|now|map|pop|iir|hat|zip|rev|sig|fft|nmf|tan|mod|pat|db|ev|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

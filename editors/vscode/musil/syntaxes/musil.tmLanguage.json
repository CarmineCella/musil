{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-skewness|synth\\-render\\-file|spectral\\-flatness|spectral\\-decrease|spectral\\-kurtosis|spectral\\-centroid|spectral\\-envelope|kmeans\\-centroids|schroeder\\-reverb|scatter\\-clusters|linreg\\-residuals|flatten\\-spectrum|train\\-test\\-split|spectral\\-rolloff|histogram\\-figure|stft\\-magnitudes|envelope\\-follow|pca\\-eigenvalues|spectral\\-moment|spectral\\-spread|impose\\-envelope|knn\\-predict\\-one|audio\\-init\\-with|normalize\\-peak|audio\\-channels|play\\-file\\-with|spectrum\\-freqs|linreg\\-predict|audio\\-running\\?|pca\\-directions|clear\\-controls|mat\\-print\\-with|spectral\\-morph|controls\\-list|spectral\\-flux|normalize\\-rms|control\\-value|gate\\-spectrum|kmeans\\-labels|pvoc\\-formants|pca\\-explained|cluster\\-sizes|add\\-intercept|median\\-filter|audio\\-devices|count\\-substr|wav\\-duration|deinterleave|plot\\-windows|synth\\-render|pvoc\\-stretch|bind\\-control|synth\\-params|assert\\-equal|starts\\-with\\?|local\\-maxima|apply\\-filter|audio\\-status|audio\\-report|udp\\-receive|add\\-scatter|knn\\-predict|complex\\-mul|standardize|append\\-file|audio\\-start|resample\\-to|spectrogram|assert\\-near|play\\-buffer|audio\\-close|master\\-gain|concat\\-list|set\\-control|dist\\-matrix|add\\-surface|fig\\-options|loop\\-buffer|add\\-subplot|write\\-lines|pvoc\\-pitch|interleave|dc\\-block\\-r|file\\-lines|x\\-or\\-index|osc\\-listen|pvoc\\-cross|audio\\-time|csv\\-escape|set\\-labels|audio\\-stop|set\\-yrange|set\\-xrange|pca\\-scores|whisperize|audio\\-init|linreg\\-fit|ends\\-with\\?|plot\\-lines|audio\\-open|set\\-params|magnitudes|set\\-option|fig\\-layers|play\\-synth|wait\\-until|audio\\-quit|streamable|histogram|transpose|mat\\-zeros|add\\-layer|write\\-csv|map\\-range|play\\-file|fig\\-title|pad\\-right|write\\-wav|live\\-loop|contains\\?|vec\\->list|sort\\-list|voice\\-set|knn\\-model|mat\\-shift|normalize|col\\-stack|file\\-size|lookahead|mat\\-print|next\\-pow2|list\\->mat|add\\-image|mat\\-round|mat\\-shape|play\\-with|mat\\-scale|extension|highshelf|fmt\\-fixed|set\\-param|find\\-file|add\\-line|subplots|osc\\-send|defined\\?|ev\\-thunk|rad\\->deg|mat\\-rand|sequence|get\\-cols|read\\-wav|robotize|hadamard|mat\\-fill|linspace|autocorr|udp\\-send|save\\-png|identity|fftshift|lowshelf|quantile|mat\\-mean|cepstrum|highpass|add\\-bars|pol\\->car|fade\\-out|mat\\-diag|deg\\->rad|mat\\-ones|synth\\-ev|get\\-rows|waveform|knn\\-test|princarg|resample|set\\-rate|between\\?|note\\-off|pad\\-left|audio\\-sr|car\\->pol|accuracy|spectrum|wait\\-for|blackman|free\\-all|basename|read\\-csv|dc\\-block|bandpass|mat\\-get|ev\\-beat|mat\\-std|set\\-pan|plot\\-xy|add\\-at!|replace|mat\\-col|control|exists\\?|play\\-at|mat\\-mul|mat\\-set|mat\\-sub|shuffle|oscbank|linefit|mat\\-add|play\\-ev|surface|flatten|note\\-at|impulse|fade\\-in|eig\\-sym|compose|lp\\-norm|reverse|note\\-on|degrade|nearest|lowpass|fmt\\-pct|mat\\-str|interp1|scatter|dirname|denoise|mat\\-map|elapsed|mat\\-sum|vec\\-mat|hamming|mat\\-vec|mat\\-row|set\\-amp|peak\\-eq|phases|empty\\?|append|median|add\\-at|unique|kmeans|biquad|hstack|format|repeat|concat|dist\\-p|reduce|max\\-of|gather|getenv|getidx|center|window|filter|acf\\-f0|argmin|equal\\?|remove|assert|min\\-of|ev\\-dur|voices|zscore|figure|cumsum|vstack|setidx|argmax|length|synths|stack|log10|istft|every|mkdir|tempo|input|shift|image|solve|steps|fixed|atan2|error|times|synth|round|lower|ncols|range|hypot|trace|nrows|sleep|count|even\\?|zeros|reson|noise|upper|delay|floor|slice|write|print|outer|clock|split|notch|file\\?|stdev|cons|prod|undb|show|odd\\?|any\\?|pvoc|sqrt|conv|sort|join|adsr|comb|each|drop|mean|free|fast|copy|sign|asin|rank|type|ifft|push|tail|stop|plot|rand|all\\?|bars|ones|exit|log2|diag|list|atan|note|lerp|vars|acos|read|head|clip|norm|corr|exec|dir\\?|stat|beat|find|play|take|stft|seed|sine|last|trim|ceil|dist|ramp|hann|diff|str|rev|pan|pow|cwd|map|inv|sin|sum|iir|zip|cat|abs|tan|now|bpf|ord|sym|cos|eye|knn|gcd|fft|hfc|min|lcm|num|dot|osc|mod|log|pca|vec|mix|lag|det|max|rms|zcr|exp|chr|cov|opt|pop|gen|ev|ls|db)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

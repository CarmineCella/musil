{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(normalize\\-peak\\-stereo|spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-flatness|spectral\\-centroid|nmf\\-separate\\-with|synth\\-render\\-file|spectral\\-decrease|clear\\-sound\\-cache|spectral\\-skewness|spectral\\-kurtosis|spectral\\-envelope|histogram\\-figure|kmeans\\-centroids|scatter\\-clusters|train\\-test\\-split|db\\-sounds\\-folder|spectral\\-rolloff|schroeder\\-reverb|linreg\\-residuals|flatten\\-spectrum|knn\\-predict\\-one|pca\\-eigenvalues|audio\\-init\\-with|envelope\\-follow|nmf\\-learn\\-parts|displayed\\-score|onsets\\-adaptive|stft\\-magnitudes|spectral\\-moment|layout\\-channels|spectral\\-spread|binaural\\-decode|impose\\-envelope|instrument\\-rank|nmf\\-spectrogram|score\\-render\\-at|play\\-score\\-from|play\\-file\\-with|register\\-score|audio\\-channels|db\\-instruments|onsets\\-of\\-flux|score\\-duration|normalize\\-peak|spectral\\-morph|nmf\\-with\\-parts|payload\\->event|onset\\-strength|max\\-re\\-weights|pca\\-directions|linreg\\-predict|audio\\-running\\?|score\\-schedule|clear\\-controls|spectrum\\-freqs|mat\\-print\\-with|score\\-play\\-now|median\\-filter|db\\-techniques|moving\\-source|spectral\\-flux|pvoc\\-formants|score\\-remove!|score\\-reverb!|db\\-available\\?|pca\\-explained|audio\\-devices|add\\-intercept|note\\-duration|controls\\-list|cluster\\-sizes|control\\-value|normalize\\-rms|kmeans\\-labels|gate\\-spectrum|starts\\-with\\?|assert\\-equal|apply\\-filter|synth\\-params|score\\-render|resolve\\-path|count\\-substr|stereo\\-scale|audio\\-status|interactive\\?|render\\-event|fit\\-duration|db\\-available|score\\-shift!|score\\-scale!|score\\-events|pvoc\\-stretch|regex\\-match\\?|princarg\\-deg|deinterleave|nmf\\-separate|score\\-select|synth\\-render|local\\-maxima|bind\\-control|onset\\-refine|plot\\-windows|wav\\-duration|audio\\-report|speaker\\-ring|event\\-lanes|db\\-features|audio\\-start|event\\-gain!|score\\-print|ambi\\-encode|db\\-dynamics|ambi\\-render|master\\-gain|loop\\-buffer|set\\-control|resample\\-to|midi\\->pitch|knn\\-predict|pitch\\->midi|score\\-sort!|standardize|nmf\\-sources|append\\-file|complex\\-mul|play\\-buffer|concerthall|spectrogram|fig\\-options|concat\\-list|add\\-scatter|udp\\-receive|ambi\\-rotate|write\\-lines|add\\-subplot|ambi\\-decode|assert\\-near|audio\\-close|add\\-surface|dist\\-matrix|pan\\-azimuth|score\\-merge|render\\-hall|score\\-roll|dc\\-block\\-r|set\\-option|db\\-nearest|osc\\-encode|ambi\\-gains|instrument|db\\-between|note\\->midi|whisperize|plot\\-lines|play\\-score|stereo\\-add|stop\\-score|set\\-labels|pvoc\\-cross|find\\-first|audio\\-init|audio\\-time|pat\\-events|osc\\-listen|csv\\-escape|streamable|set\\-params|audio\\-stop|db\\-pitches|x\\-or\\-index|pca\\-scores|hrir\\-model|set\\-xrange|magnitudes|play\\-event|audio\\-quit|play\\-synth|wait\\-until|directory\\?|arp\\-events|set\\-yrange|audio\\-open|file\\-lines|interleave|score\\-rows|fig\\-layers|trance\\-kit|load\\-sound|ends\\-with\\?|techno\\-kit|pvoc\\-pitch|linreg\\-fit|mat\\-round|fig\\-title|pad\\-right|sort\\-list|add\\-image|remove\\-at|write\\-wav|list\\->mat|mat\\-print|house\\-kit|col\\-stack|note\\-path|knn\\-model|nmf\\-error|map\\-range|playhead!|set\\-param|histogram|file\\-size|mat\\-zeros|transpose|voice\\-set|db\\-locate|mat\\-shape|find\\-file|event\\-end|contains\\?|roll\\-play|mat\\-scale|hrtf\\-load|fmt\\-fixed|next\\-pow2|insert\\-at|partition|live\\-loop|highshelf|mat\\-shift|write\\-csv|lookahead|add\\-layer|extension|sometimes|normalize|play\\-file|play\\-with|vec\\->list|get\\-cols|filename|humanize|bandpass|fade\\-out|pol\\->car|accuracy|lowshelf|car\\->pol|identity|get\\-rows|rad\\->deg|set\\-rate|mat\\-mean|add\\-line|db\\-merge|group\\-by|audio\\-sr|add\\-bars|ev\\-thunk|wait\\-for|midi\\->hz|between\\?|mat\\-rand|highpass|robotize|supersaw|chord\\-ev|binaural|autocorr|resample|save\\-png|hadamard|blackman|mat\\-diag|segments|mat\\-fill|mat\\-ones|deg\\->rad|cepstrum|score\\-sr|read\\-csv|spectrum|linspace|osc\\-send|free\\-all|fftshift|db\\-range|defined\\?|ambi\\-add|pad\\-left|sequence|udp\\-send|subplots|hz\\->midi|waveform|basename|synth\\-ev|read\\-wav|princarg|note\\-off|quantile|event\\-at|knn\\-test|dc\\-block|db\\-query|scatter|set\\-amp|replace|oscbank|to\\-rate|mat\\-max|impulse|mat\\-min|db\\-load|note\\-on|lp\\-norm|mat\\-set|play\\-ev|fn\\-name|mat\\-get|mat\\-mul|compose|db\\-read|db\\-make|accents|eig\\-sym|add\\-at!|fmt\\-pct|denoise|mat\\-map|linefit|shuffle|interp1|mat\\-sub|hall\\-ir|mat\\-row|mat\\-std|offbass|degrade|mat\\-str|hamming|mat\\-add|mat\\-col|lowpass|surface|control|fade\\-in|db\\-size|dirname|play\\-at|nearest|db\\-path|flatten|db\\-grep|peak\\-eq|note\\-at|mat\\-sum|ev\\-beat|display|channel|mat\\-div|elapsed|vec\\-mat|exists\\?|converb|db\\-find|set\\-pan|sort\\-by|plot\\-xy|mat\\-vec|reverse|reduce|min\\-of|append|kmeans|min\\-by|assert|onsets|setidx|values|remove|record|center|dist\\-p|argmin|equal\\?|length|acf\\-f0|argmax|getidx|window|median|figure|vstack|biquad|getenv|chance|voices|euclid|reject|add\\-at|cumsum|empty\\?|render|repeat|hstack|concat|format|synths|max\\-by|filter|sum\\-by|zscore|db\\-gen|phases|hoover|max\\-of|rumble|gather|unique|ev\\-dur|melody|atan2|solve|floor|sweep|sleep|trace|tempo|istft|image|chord|even\\?|score|split|hypot|stack|round|file\\?|ncols|drums|tkick|synth|reson|tclap|outer|lower|clock|serve|swing|steps|count|delay|upper|input|pluck|mkdir|zeros|notch|gater|times|range|every|slice|print|write|place|stdev|parse|nrows|error|shift|tstab|fixed|snare|noise|pan\\-n|riser|tohat|event|log10|hann|tpad|sqrt|diag|odd\\?|tanh|tail|clip|copy|perc|take|pvoc|join|ohat|all\\?|clap|read|corr|exec|show|free|play|roll|stft|mean|plot|hpss|keys|has\\?|that|kick|trim|lerp|find|asin|stat|ceil|diff|put!|stab|type|drop|each|duck|sine|vars|rank|dir\\?|head|beat|sign|acos|any\\?|dist|poly|fast|hrir|stop|last|push|log2|ramp|rand|acid|conv|note|undb|adsr|prod|sort|norm|ones|ifft|call|list|seed|bars|atan|exit|comb|pow|now|num|lag|hfc|tan|rev|nmf|arp|zcr|pca|get|cos|cwd|pan|ord|sym|rms|mod|lcm|fft|gen|pop|opt|gcd|map|mix|sub|sum|cov|det|pat|vec|chr|iir|zip|exp|abs|sig|zap|min|str|log|eye|cat|osc|hat|sin|inv|knn|pad|dot|max|bpf|put|ev|ls|db)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

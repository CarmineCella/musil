{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|synth\\-render\\-file|spectral\\-skewness|spectral\\-centroid|spectral\\-kurtosis|spectral\\-decrease|spectral\\-envelope|spectral\\-flatness|kmeans\\-centroids|histogram\\-figure|linreg\\-residuals|spectral\\-rolloff|scatter\\-clusters|schroeder\\-reverb|train\\-test\\-split|flatten\\-spectrum|pca\\-eigenvalues|spectral\\-spread|knn\\-predict\\-one|stft\\-magnitudes|audio\\-init\\-with|envelope\\-follow|impose\\-envelope|spectral\\-moment|mat\\-print\\-with|clear\\-controls|audio\\-channels|pca\\-directions|normalize\\-peak|play\\-file\\-with|spectrum\\-freqs|linreg\\-predict|audio\\-running\\?|spectral\\-morph|spectral\\-flux|kmeans\\-labels|control\\-value|pvoc\\-formants|audio\\-devices|median\\-filter|pca\\-explained|gate\\-spectrum|cluster\\-sizes|add\\-intercept|normalize\\-rms|controls\\-list|plot\\-windows|synth\\-render|audio\\-status|audio\\-report|deinterleave|pvoc\\-stretch|count\\-substr|wav\\-duration|synth\\-params|bind\\-control|local\\-maxima|starts\\-with\\?|apply\\-filter|assert\\-equal|assert\\-near|add\\-surface|add\\-subplot|append\\-file|audio\\-close|play\\-buffer|loop\\-buffer|fig\\-options|spectrogram|set\\-control|resample\\-to|add\\-scatter|concat\\-list|udp\\-receive|knn\\-predict|master\\-gain|dist\\-matrix|standardize|audio\\-start|write\\-lines|complex\\-mul|osc\\-encode|set\\-option|note\\->midi|audio\\-quit|set\\-xrange|csv\\-escape|x\\-or\\-index|fig\\-layers|audio\\-stop|streamable|pca\\-scores|audio\\-init|set\\-yrange|audio\\-open|pvoc\\-cross|ends\\-with\\?|audio\\-time|osc\\-listen|pat\\-events|whisperize|linreg\\-fit|dc\\-block\\-r|plot\\-lines|set\\-params|interleave|pvoc\\-pitch|set\\-labels|file\\-lines|play\\-synth|wait\\-until|magnitudes|histogram|mat\\-round|write\\-wav|extension|add\\-image|mat\\-zeros|find\\-file|play\\-with|mat\\-print|next\\-pow2|house\\-kit|vec\\->list|play\\-file|map\\-range|col\\-stack|list\\->mat|mat\\-shift|live\\-loop|voice\\-set|sort\\-list|pad\\-right|contains\\?|fmt\\-fixed|write\\-csv|knn\\-model|add\\-layer|sometimes|lookahead|set\\-param|normalize|transpose|mat\\-scale|mat\\-shape|file\\-size|fig\\-title|highshelf|midi\\->hz|accuracy|get\\-cols|wait\\-for|free\\-all|humanize|save\\-png|mat\\-fill|ev\\-thunk|spectrum|hadamard|mat\\-diag|pol\\->car|lowshelf|set\\-rate|udp\\-send|knn\\-test|car\\->pol|mat\\-rand|fade\\-out|rad\\->deg|cepstrum|waveform|read\\-csv|mat\\-ones|resample|highpass|hz\\->midi|identity|princarg|audio\\-sr|osc\\-send|between\\?|deg\\->rad|subplots|add\\-bars|defined\\?|linspace|get\\-rows|dc\\-block|blackman|quantile|mat\\-mean|sequence|bandpass|chord\\-ev|basename|read\\-wav|autocorr|robotize|synth\\-ev|note\\-off|pad\\-left|fftshift|add\\-line|compose|lowpass|set\\-pan|plot\\-xy|degrade|mat\\-get|play\\-at|vec\\-mat|interp1|surface|mat\\-add|set\\-amp|denoise|mat\\-sum|elapsed|mat\\-vec|replace|peak\\-eq|ev\\-beat|exists\\?|reverse|mat\\-sub|shuffle|eig\\-sym|mat\\-mul|mat\\-std|dirname|mat\\-str|note\\-on|mat\\-set|hamming|control|fmt\\-pct|nearest|mat\\-row|linefit|impulse|flatten|mat\\-map|play\\-ev|fade\\-in|note\\-at|scatter|oscbank|add\\-at!|lp\\-norm|mat\\-col|getenv|min\\-of|center|append|assert|synths|vstack|acf\\-f0|window|empty\\?|argmax|reduce|format|ev\\-dur|melody|length|equal\\?|unique|getidx|figure|hstack|biquad|phases|chance|argmin|kmeans|euclid|remove|concat|max\\-of|dist\\-p|repeat|add\\-at|median|setidx|gather|voices|filter|cumsum|zscore|round|times|every|chord|snare|drums|slice|count|sleep|file\\?|shift|upper|reson|noise|zeros|stack|floor|error|tempo|write|trace|nrows|fixed|split|lower|input|mkdir|log10|istft|clock|even\\?|stdev|hypot|notch|delay|synth|atan2|ncols|swing|print|image|range|outer|solve|steps|clap|acos|diag|read|note|ohat|exit|diff|head|odd\\?|copy|sign|type|rank|join|pvoc|last|kick|mean|exec|seed|adsr|each|ramp|stat|corr|all\\?|hann|drop|stop|tail|bars|tanh|prod|poly|norm|any\\?|play|lerp|fast|vars|clip|sort|ones|plot|push|stft|stab|sine|dir\\?|undb|cons|conv|show|trim|free|take|comb|beat|find|sqrt|list|log2|atan|dist|ifft|asin|acid|ceil|rand|hat|pad|pop|vec|opt|knn|rms|lcm|det|pan|min|log|gcd|str|gen|inv|sum|now|eye|mix|bpf|num|iir|cat|pow|pca|abs|chr|tan|lag|cov|zcr|rev|osc|hfc|exp|fft|cwd|ord|map|sym|sin|mod|cos|pat|max|dot|zip|ls|ev|db)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(normalize\\-peak\\-stereo|spectral\\-irregularity|envelope\\-from\\-values|pvoc\\-pitch\\-formant|magnitude\\-spectrum|spectral\\-envelope|spectral\\-flatness|spectral\\-decrease|spectral\\-centroid|spectral\\-kurtosis|spectral\\-skewness|synth\\-render\\-file|spectral\\-rolloff|schroeder\\-reverb|linreg\\-residuals|train\\-test\\-split|flatten\\-spectrum|scatter\\-clusters|kmeans\\-centroids|histogram\\-figure|envelope\\-follow|spectral\\-moment|audio\\-init\\-with|spectral\\-spread|pca\\-eigenvalues|onsets\\-adaptive|knn\\-predict\\-one|impose\\-envelope|binaural\\-decode|stft\\-magnitudes|clear\\-controls|onsets\\-of\\-flux|audio\\-running\\?|onset\\-strength|play\\-file\\-with|normalize\\-peak|linreg\\-predict|audio\\-channels|spectral\\-morph|mat\\-print\\-with|max\\-re\\-weights|spectrum\\-freqs|pca\\-directions|add\\-intercept|gate\\-spectrum|pca\\-explained|kmeans\\-labels|spectral\\-flux|normalize\\-rms|cluster\\-sizes|median\\-filter|pvoc\\-formants|controls\\-list|audio\\-devices|moving\\-source|control\\-value|stereo\\-scale|local\\-maxima|wav\\-duration|plot\\-windows|synth\\-render|audio\\-report|pvoc\\-stretch|interactive\\?|deinterleave|apply\\-filter|synth\\-params|bind\\-control|starts\\-with\\?|count\\-substr|nmf\\-separate|assert\\-equal|princarg\\-deg|audio\\-status|onset\\-refine|speaker\\-ring|audio\\-close|add\\-surface|set\\-control|fig\\-options|resample\\-to|master\\-gain|knn\\-predict|dist\\-matrix|concat\\-list|loop\\-buffer|add\\-subplot|pan\\-azimuth|ambi\\-encode|append\\-file|audio\\-start|assert\\-near|add\\-scatter|ambi\\-rotate|complex\\-mul|ambi\\-render|ambi\\-decode|write\\-lines|standardize|spectrogram|play\\-buffer|udp\\-receive|stereo\\-add|whisperize|csv\\-escape|pvoc\\-cross|audio\\-init|wait\\-until|magnitudes|set\\-labels|set\\-yrange|set\\-option|play\\-synth|linreg\\-fit|note\\->midi|pvoc\\-pitch|ends\\-with\\?|techno\\-kit|pat\\-events|trance\\-kit|arp\\-events|audio\\-time|file\\-lines|audio\\-quit|ambi\\-gains|interleave|hrir\\-model|fig\\-layers|audio\\-stop|audio\\-open|streamable|set\\-xrange|plot\\-lines|osc\\-listen|pca\\-scores|x\\-or\\-index|set\\-params|osc\\-encode|dc\\-block\\-r|mat\\-scale|lookahead|add\\-image|mat\\-shape|write\\-wav|play\\-file|hrtf\\-load|set\\-param|mat\\-shift|sometimes|histogram|vec\\->list|normalize|mat\\-print|list\\->mat|pad\\-right|play\\-with|live\\-loop|voice\\-set|contains\\?|fig\\-title|transpose|mat\\-round|fmt\\-fixed|house\\-kit|col\\-stack|mat\\-zeros|find\\-file|next\\-pow2|sort\\-list|highshelf|knn\\-model|add\\-layer|file\\-size|write\\-csv|map\\-range|nmf\\-error|extension|spectrum|mat\\-rand|get\\-rows|basename|pad\\-left|accuracy|add\\-bars|get\\-cols|wait\\-for|add\\-line|fftshift|quantile|autocorr|audio\\-sr|midi\\->hz|synth\\-ev|mat\\-ones|car\\->pol|hadamard|binaural|princarg|supersaw|set\\-rate|waveform|robotize|mat\\-mean|segments|dc\\-block|free\\-all|deg\\->rad|bandpass|between\\?|rad\\->deg|mat\\-diag|highpass|ambi\\-add|lowshelf|blackman|note\\-off|identity|fade\\-out|sequence|linspace|humanize|defined\\?|subplots|save\\-png|hz\\->midi|read\\-csv|mat\\-fill|chord\\-ev|read\\-wav|resample|cepstrum|ev\\-thunk|knn\\-test|osc\\-send|pol\\->car|udp\\-send|mat\\-map|ev\\-beat|mat\\-vec|accents|note\\-on|interp1|elapsed|dirname|plot\\-xy|oscbank|mat\\-max|eig\\-sym|denoise|mat\\-set|mat\\-mul|reverse|mat\\-min|lowpass|mat\\-div|mat\\-std|mat\\-add|surface|vec\\-mat|impulse|peak\\-eq|set\\-amp|mat\\-sub|lp\\-norm|fmt\\-pct|nearest|fade\\-in|note\\-at|add\\-at!|linefit|mat\\-sum|mat\\-str|mat\\-get|offbass|replace|play\\-ev|compose|scatter|channel|flatten|set\\-pan|exists\\?|play\\-at|degrade|shuffle|hamming|mat\\-col|control|mat\\-row|equal\\?|empty\\?|phases|repeat|format|setidx|kmeans|dist\\-p|vstack|window|cumsum|add\\-at|onsets|argmax|reduce|hstack|voices|figure|max\\-of|remove|rumble|append|length|min\\-of|center|chance|biquad|ev\\-dur|filter|euclid|melody|getidx|concat|median|assert|gather|hoover|unique|argmin|acf\\-f0|zscore|synths|getenv|riser|error|nrows|lower|range|sleep|split|floor|stack|drums|ncols|parse|pluck|reson|clock|trace|write|count|image|hypot|tempo|sweep|steps|upper|swing|fixed|shift|round|notch|input|outer|atan2|gater|synth|snare|zeros|solve|slice|file\\?|even\\?|pan\\-n|times|chord|print|log10|stdev|noise|tkick|tstab|mkdir|istft|delay|every|tohat|tclap|sign|show|sqrt|vars|log2|beat|adsr|play|free|pvoc|norm|ones|diff|that|list|note|type|bars|corr|dist|poly|roll|comb|acid|perc|fast|last|diag|sine|rand|mean|ifft|atan|stat|take|trim|clap|acos|seed|exec|dir\\?|tail|exit|rank|any\\?|odd\\?|tanh|cons|plot|stab|hpss|stft|copy|find|lerp|ohat|read|conv|all\\?|hann|undb|push|head|stop|join|kick|clip|drop|sort|tpad|duck|prod|hrir|ceil|each|asin|ramp|pad|bpf|sum|zip|ord|sym|chr|iir|sig|rev|fft|sin|gcd|gen|dot|hfc|zcr|det|pan|pat|abs|num|str|cwd|cov|mix|cos|arp|mod|pca|rms|pop|opt|osc|knn|log|map|cat|nmf|pow|min|inv|exp|sub|eye|hat|zap|lag|lcm|max|tan|now|vec|db|ev|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-centroid|spectral\\-flatness|spectral\\-skewness|synth\\-render\\-file|spectral\\-decrease|spectral\\-envelope|spectral\\-kurtosis|kmeans\\-centroids|spectral\\-rolloff|histogram\\-figure|train\\-test\\-split|schroeder\\-reverb|flatten\\-spectrum|linreg\\-residuals|scatter\\-clusters|spectral\\-spread|onsets\\-adaptive|spectral\\-moment|pca\\-eigenvalues|audio\\-init\\-with|knn\\-predict\\-one|stft\\-magnitudes|impose\\-envelope|envelope\\-follow|spectrum\\-freqs|onset\\-strength|play\\-file\\-with|onsets\\-of\\-flux|spectral\\-morph|linreg\\-predict|clear\\-controls|audio\\-channels|audio\\-running\\?|mat\\-print\\-with|pca\\-directions|normalize\\-peak|controls\\-list|pca\\-explained|kmeans\\-labels|audio\\-devices|add\\-intercept|gate\\-spectrum|control\\-value|median\\-filter|pvoc\\-formants|normalize\\-rms|cluster\\-sizes|spectral\\-flux|starts\\-with\\?|pvoc\\-stretch|apply\\-filter|audio\\-status|audio\\-report|plot\\-windows|assert\\-equal|deinterleave|synth\\-render|local\\-maxima|bind\\-control|count\\-substr|wav\\-duration|synth\\-params|onset\\-refine|interactive\\?|audio\\-close|fig\\-options|add\\-scatter|write\\-lines|concat\\-list|master\\-gain|add\\-surface|audio\\-start|append\\-file|dist\\-matrix|loop\\-buffer|assert\\-near|complex\\-mul|resample\\-to|spectrogram|udp\\-receive|play\\-buffer|set\\-control|standardize|add\\-subplot|knn\\-predict|techno\\-kit|audio\\-quit|pat\\-events|pca\\-scores|set\\-params|wait\\-until|play\\-synth|audio\\-init|interleave|set\\-xrange|file\\-lines|x\\-or\\-index|audio\\-open|pvoc\\-pitch|dc\\-block\\-r|set\\-option|audio\\-time|streamable|trance\\-kit|set\\-yrange|osc\\-encode|audio\\-stop|ends\\-with\\?|csv\\-escape|arp\\-events|whisperize|magnitudes|set\\-labels|linreg\\-fit|pvoc\\-cross|plot\\-lines|note\\->midi|osc\\-listen|fig\\-layers|col\\-stack|file\\-size|house\\-kit|extension|map\\-range|mat\\-round|next\\-pow2|lookahead|fmt\\-fixed|mat\\-scale|normalize|pad\\-right|vec\\->list|fig\\-title|mat\\-shift|contains\\?|set\\-param|transpose|write\\-wav|highshelf|play\\-with|add\\-image|sort\\-list|sometimes|add\\-layer|mat\\-zeros|list\\->mat|voice\\-set|play\\-file|live\\-loop|knn\\-model|find\\-file|histogram|mat\\-print|mat\\-shape|write\\-csv|basename|fftshift|defined\\?|audio\\-sr|waveform|udp\\-send|set\\-rate|bandpass|princarg|wait\\-for|midi\\->hz|mat\\-mean|quantile|fade\\-out|read\\-wav|add\\-bars|chord\\-ev|linspace|ev\\-thunk|resample|blackman|cepstrum|lowshelf|read\\-csv|save\\-png|osc\\-send|mat\\-ones|mat\\-rand|deg\\->rad|hadamard|supersaw|autocorr|subplots|between\\?|identity|get\\-rows|highpass|pol\\->car|free\\-all|mat\\-diag|sequence|robotize|car\\->pol|humanize|segments|rad\\->deg|spectrum|knn\\-test|hz\\->midi|add\\-line|note\\-off|dc\\-block|get\\-cols|mat\\-fill|accuracy|synth\\-ev|pad\\-left|peak\\-eq|mat\\-map|note\\-on|play\\-ev|mat\\-vec|hamming|mat\\-sub|mat\\-sum|set\\-pan|eig\\-sym|ev\\-beat|linefit|lowpass|interp1|mat\\-get|surface|mat\\-str|accents|note\\-at|set\\-amp|flatten|vec\\-mat|fade\\-in|dirname|nearest|fmt\\-pct|mat\\-mul|add\\-at!|play\\-at|plot\\-xy|replace|control|scatter|oscbank|denoise|impulse|mat\\-row|elapsed|mat\\-set|offbass|shuffle|degrade|mat\\-std|compose|mat\\-add|reverse|lp\\-norm|mat\\-col|exists\\?|unique|onsets|vstack|euclid|rumble|assert|dist\\-p|argmax|phases|filter|add\\-at|getidx|getenv|append|synths|window|zscore|chance|length|gather|cumsum|biquad|figure|kmeans|max\\-of|hstack|median|voices|ev\\-dur|hoover|min\\-of|reduce|empty\\?|equal\\?|melody|center|argmin|remove|format|acf\\-f0|setidx|concat|repeat|tclap|ncols|error|tempo|nrows|lower|floor|mkdir|gater|round|pluck|parse|split|synth|zeros|notch|swing|even\\?|log10|tstab|count|drums|input|range|sweep|riser|clock|file\\?|chord|istft|fixed|stdev|times|image|shift|tkick|hypot|sleep|reson|steps|stack|snare|tohat|slice|trace|outer|delay|atan2|write|solve|print|every|upper|noise|stft|fast|list|last|ones|each|exec|clap|drop|perc|diff|take|ramp|adsr|prod|duck|diag|asin|log2|rank|trim|roll|any\\?|seed|stop|stab|copy|free|corr|ceil|tanh|beat|tail|rand|dist|push|type|find|clip|acid|lerp|norm|ohat|conv|join|atan|that|acos|undb|plot|note|hpss|exit|ifft|sqrt|hann|odd\\?|vars|sort|tpad|dir\\?|stat|poly|show|play|sine|all\\?|pvoc|head|sign|read|kick|mean|bars|cons|comb|opt|mix|vec|tan|sum|cat|chr|arp|pad|ord|cwd|inv|sig|max|log|sym|sin|cos|str|zap|gen|min|zcr|mod|pop|lcm|eye|gcd|cov|pan|bpf|zip|num|pat|rms|iir|dot|map|knn|pca|fft|lag|hfc|hat|rev|now|exp|det|pow|abs|osc|sub|ls|db|ev)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

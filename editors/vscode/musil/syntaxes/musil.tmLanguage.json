{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|pvoc\\-pitch\\-formant|magnitude\\-spectrum|spectral\\-kurtosis|spectral\\-skewness|spectral\\-flatness|spectral\\-centroid|synth\\-render\\-file|spectral\\-envelope|spectral\\-decrease|histogram\\-figure|kmeans\\-centroids|flatten\\-spectrum|spectral\\-rolloff|scatter\\-clusters|train\\-test\\-split|linreg\\-residuals|schroeder\\-reverb|spectral\\-moment|spectral\\-spread|pca\\-eigenvalues|envelope\\-follow|audio\\-init\\-with|impose\\-envelope|knn\\-predict\\-one|onsets\\-adaptive|stft\\-magnitudes|normalize\\-peak|pca\\-directions|audio\\-channels|onsets\\-of\\-flux|spectrum\\-freqs|mat\\-print\\-with|linreg\\-predict|spectral\\-morph|audio\\-running\\?|play\\-file\\-with|clear\\-controls|onset\\-strength|control\\-value|kmeans\\-labels|pvoc\\-formants|gate\\-spectrum|spectral\\-flux|add\\-intercept|median\\-filter|cluster\\-sizes|normalize\\-rms|audio\\-devices|controls\\-list|pca\\-explained|synth\\-render|synth\\-params|plot\\-windows|count\\-substr|pvoc\\-stretch|assert\\-equal|local\\-maxima|audio\\-status|deinterleave|interactive\\?|apply\\-filter|onset\\-refine|audio\\-report|bind\\-control|wav\\-duration|starts\\-with\\?|knn\\-predict|assert\\-near|add\\-scatter|add\\-subplot|add\\-surface|dist\\-matrix|fig\\-options|master\\-gain|audio\\-start|resample\\-to|complex\\-mul|concat\\-list|set\\-control|audio\\-close|play\\-buffer|append\\-file|write\\-lines|spectrogram|standardize|loop\\-buffer|udp\\-receive|pvoc\\-cross|fig\\-layers|pca\\-scores|ends\\-with\\?|plot\\-lines|magnitudes|interleave|audio\\-stop|trance\\-kit|file\\-lines|audio\\-init|osc\\-listen|linreg\\-fit|wait\\-until|play\\-synth|set\\-labels|dc\\-block\\-r|set\\-params|set\\-xrange|pvoc\\-pitch|x\\-or\\-index|osc\\-encode|techno\\-kit|streamable|whisperize|csv\\-escape|audio\\-time|pat\\-events|set\\-option|note\\->midi|audio\\-open|audio\\-quit|arp\\-events|set\\-yrange|knn\\-model|sometimes|vec\\->list|play\\-file|highshelf|normalize|histogram|sort\\-list|mat\\-scale|pad\\-right|transpose|write\\-csv|lookahead|file\\-size|map\\-range|write\\-wav|mat\\-print|mat\\-zeros|house\\-kit|voice\\-set|fmt\\-fixed|add\\-layer|extension|next\\-pow2|play\\-with|contains\\?|live\\-loop|find\\-file|add\\-image|list\\->mat|fig\\-title|mat\\-round|col\\-stack|set\\-param|mat\\-shift|mat\\-shape|udp\\-send|audio\\-sr|synth\\-ev|basename|add\\-line|mat\\-diag|free\\-all|add\\-bars|mat\\-ones|humanize|knn\\-test|read\\-wav|bandpass|pol\\->car|hz\\->midi|mat\\-mean|cepstrum|quantile|midi\\->hz|lowshelf|pad\\-left|car\\->pol|linspace|get\\-cols|supersaw|get\\-rows|accuracy|read\\-csv|defined\\?|mat\\-rand|note\\-off|blackman|rad\\->deg|robotize|deg\\->rad|sequence|set\\-rate|mat\\-fill|osc\\-send|highpass|dc\\-block|princarg|save\\-png|identity|resample|autocorr|spectrum|wait\\-for|chord\\-ev|subplots|segments|ev\\-thunk|fade\\-out|hadamard|fftshift|waveform|between\\?|set\\-pan|offbass|mat\\-set|impulse|eig\\-sym|elapsed|scatter|surface|control|hamming|mat\\-mul|fade\\-in|vec\\-mat|add\\-at!|flatten|exists\\?|denoise|plot\\-xy|lp\\-norm|set\\-amp|accents|interp1|lowpass|mat\\-std|peak\\-eq|shuffle|play\\-ev|replace|play\\-at|note\\-on|reverse|nearest|note\\-at|mat\\-col|linefit|mat\\-get|compose|dirname|fmt\\-pct|mat\\-add|mat\\-str|ev\\-beat|mat\\-row|mat\\-vec|mat\\-sub|oscbank|degrade|mat\\-sum|mat\\-map|format|window|remove|onsets|median|argmax|chance|add\\-at|gather|figure|hoover|kmeans|acf\\-f0|getenv|setidx|unique|vstack|append|zscore|biquad|repeat|center|cumsum|filter|reduce|voices|min\\-of|phases|getidx|length|ev\\-dur|rumble|dist\\-p|assert|euclid|argmin|empty\\?|max\\-of|concat|equal\\?|hstack|synths|melody|lower|noise|stack|tkick|slice|input|tclap|even\\?|gater|shift|clock|image|solve|write|outer|error|tohat|synth|ncols|riser|fixed|chord|zeros|nrows|mkdir|swing|pluck|file\\?|hypot|notch|count|times|stdev|sleep|upper|delay|print|log10|floor|drums|sweep|split|atan2|round|tempo|snare|parse|range|reson|istft|trace|every|tstab|steps|tanh|ones|rank|hann|last|plot|play|prod|acid|stft|join|seed|take|rand|clap|exit|bars|head|poly|ohat|dir\\?|list|odd\\?|cons|type|diff|that|roll|sqrt|comb|any\\?|pvoc|asin|stat|all\\?|sort|hpss|show|copy|conv|ramp|dist|lerp|ifft|tpad|tail|beat|ceil|norm|stab|trim|push|adsr|acos|sign|each|kick|stop|find|drop|vars|atan|mean|exec|diag|corr|clip|undb|log2|read|note|free|duck|sine|perc|fast|ord|zip|gcd|cos|mix|eye|str|osc|inv|cat|fft|dot|num|now|pad|log|pca|hat|abs|pan|lcm|min|max|cwd|sig|zcr|rev|knn|tan|gen|cov|map|opt|chr|sym|bpf|sum|zap|iir|lag|mod|pop|pat|vec|exp|det|hfc|sub|pow|arp|sin|rms|ls|db|ev)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-centroid|synth\\-render\\-file|spectral\\-flatness|spectral\\-decrease|spectral\\-envelope|spectral\\-kurtosis|spectral\\-skewness|spectral\\-rolloff|train\\-test\\-split|schroeder\\-reverb|scatter\\-clusters|linreg\\-residuals|kmeans\\-centroids|flatten\\-spectrum|histogram\\-figure|impose\\-envelope|envelope\\-follow|pca\\-eigenvalues|spectral\\-spread|spectral\\-moment|knn\\-predict\\-one|audio\\-init\\-with|stft\\-magnitudes|normalize\\-peak|mat\\-print\\-with|pca\\-directions|play\\-file\\-with|linreg\\-predict|spectrum\\-freqs|clear\\-controls|audio\\-running\\?|audio\\-channels|spectral\\-morph|gate\\-spectrum|controls\\-list|kmeans\\-labels|pca\\-explained|pvoc\\-formants|control\\-value|add\\-intercept|spectral\\-flux|normalize\\-rms|cluster\\-sizes|median\\-filter|audio\\-devices|plot\\-windows|synth\\-params|wav\\-duration|assert\\-equal|bind\\-control|audio\\-status|synth\\-render|count\\-substr|starts\\-with\\?|apply\\-filter|audio\\-report|deinterleave|local\\-maxima|pvoc\\-stretch|audio\\-close|add\\-scatter|fig\\-options|udp\\-receive|write\\-lines|complex\\-mul|loop\\-buffer|assert\\-near|knn\\-predict|play\\-buffer|master\\-gain|add\\-subplot|audio\\-start|spectrogram|resample\\-to|append\\-file|dist\\-matrix|concat\\-list|set\\-control|standardize|add\\-surface|pvoc\\-pitch|audio\\-quit|osc\\-encode|fig\\-layers|csv\\-escape|file\\-lines|note\\->midi|audio\\-time|audio\\-open|set\\-yrange|ends\\-with\\?|pvoc\\-cross|streamable|dc\\-block\\-r|pca\\-scores|osc\\-listen|interleave|linreg\\-fit|audio\\-init|techno\\-kit|plot\\-lines|whisperize|set\\-xrange|magnitudes|set\\-option|x\\-or\\-index|set\\-params|set\\-labels|play\\-synth|pat\\-events|wait\\-until|audio\\-stop|add\\-image|list\\->mat|normalize|knn\\-model|mat\\-round|mat\\-scale|file\\-size|next\\-pow2|contains\\?|highshelf|vec\\->list|pad\\-right|sometimes|mat\\-shift|mat\\-print|histogram|map\\-range|mat\\-shape|extension|play\\-with|voice\\-set|add\\-layer|write\\-csv|mat\\-zeros|col\\-stack|find\\-file|live\\-loop|house\\-kit|transpose|sort\\-list|fig\\-title|play\\-file|write\\-wav|fmt\\-fixed|lookahead|set\\-param|knn\\-test|humanize|quantile|fade\\-out|synth\\-ev|mat\\-fill|highpass|get\\-cols|mat\\-diag|pad\\-left|blackman|note\\-off|identity|read\\-csv|udp\\-send|linspace|set\\-rate|car\\->pol|wait\\-for|get\\-rows|spectrum|waveform|resample|dc\\-block|ev\\-thunk|midi\\->hz|autocorr|chord\\-ev|add\\-line|pol\\->car|rad\\->deg|fftshift|mat\\-rand|princarg|save\\-png|audio\\-sr|robotize|read\\-wav|cepstrum|add\\-bars|between\\?|hz\\->midi|defined\\?|hadamard|free\\-all|basename|osc\\-send|mat\\-ones|accuracy|subplots|mat\\-mean|deg\\->rad|lowshelf|bandpass|sequence|linefit|hamming|mat\\-add|exists\\?|set\\-pan|scatter|control|eig\\-sym|mat\\-mul|flatten|note\\-on|peak\\-eq|mat\\-map|lowpass|mat\\-std|play\\-at|mat\\-set|lp\\-norm|mat\\-col|elapsed|ev\\-beat|surface|denoise|plot\\-xy|impulse|replace|mat\\-str|compose|dirname|nearest|mat\\-vec|interp1|accents|mat\\-get|note\\-at|fmt\\-pct|set\\-amp|reverse|degrade|mat\\-row|oscbank|mat\\-sum|add\\-at!|play\\-ev|shuffle|vec\\-mat|fade\\-in|mat\\-sub|ev\\-dur|argmax|kmeans|add\\-at|equal\\?|getidx|concat|center|biquad|format|getenv|cumsum|synths|vstack|length|min\\-of|gather|setidx|acf\\-f0|chance|figure|append|median|euclid|empty\\?|filter|repeat|argmin|remove|window|assert|rumble|zscore|dist\\-p|hstack|unique|phases|hoover|melody|max\\-of|voices|reduce|even\\?|tkick|drums|fixed|clock|write|error|notch|split|zeros|slice|print|tclap|image|tstab|tohat|log10|stdev|steps|nrows|tempo|swing|synth|every|delay|floor|file\\?|lower|round|chord|snare|atan2|parse|sweep|upper|range|trace|shift|input|mkdir|noise|istft|hypot|count|sleep|times|outer|reson|solve|ncols|stack|stft|ohat|stab|acos|type|dist|kick|show|adsr|prod|duck|corr|push|ones|drop|stop|conv|vars|hann|odd\\?|tanh|sqrt|play|ifft|head|copy|cons|list|join|mean|poly|exec|ceil|clap|dir\\?|fast|find|that|asin|atan|diff|sign|read|each|exit|norm|undb|trim|free|bars|lerp|any\\?|last|rank|clip|rand|acid|tpad|seed|perc|log2|diag|ramp|all\\?|take|beat|comb|pvoc|note|sine|stat|plot|tail|sort|hat|pow|mix|min|rev|exp|cov|sum|str|bpf|dot|pat|zap|sym|chr|gen|pan|vec|ord|fft|zip|knn|sig|lcm|pca|num|eye|tan|sin|rms|gcd|abs|max|hfc|det|cat|cwd|iir|map|now|cos|inv|osc|log|opt|zcr|pop|sub|pad|lag|mod|db|ev|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

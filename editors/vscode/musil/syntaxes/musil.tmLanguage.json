{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|normalize\\-peak\\-stereo|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-flatness|spectral\\-skewness|spectral\\-centroid|synth\\-render\\-file|spectral\\-kurtosis|spectral\\-envelope|spectral\\-decrease|nmf\\-separate\\-with|histogram\\-figure|flatten\\-spectrum|spectral\\-rolloff|scatter\\-clusters|train\\-test\\-split|linreg\\-residuals|schroeder\\-reverb|kmeans\\-centroids|binaural\\-decode|onsets\\-adaptive|envelope\\-follow|spectral\\-spread|pca\\-eigenvalues|spectral\\-moment|audio\\-init\\-with|knn\\-predict\\-one|nmf\\-spectrogram|nmf\\-learn\\-parts|stft\\-magnitudes|impose\\-envelope|audio\\-running\\?|normalize\\-peak|nmf\\-with\\-parts|spectral\\-morph|onset\\-strength|linreg\\-predict|play\\-file\\-with|spectrum\\-freqs|mat\\-print\\-with|max\\-re\\-weights|pca\\-directions|clear\\-controls|audio\\-channels|onsets\\-of\\-flux|audio\\-devices|pvoc\\-formants|spectral\\-flux|gate\\-spectrum|median\\-filter|cluster\\-sizes|controls\\-list|normalize\\-rms|kmeans\\-labels|moving\\-source|pca\\-explained|control\\-value|add\\-intercept|synth\\-render|audio\\-status|starts\\-with\\?|count\\-substr|nmf\\-separate|deinterleave|onset\\-refine|assert\\-equal|bind\\-control|speaker\\-ring|princarg\\-deg|stereo\\-scale|local\\-maxima|synth\\-params|wav\\-duration|interactive\\?|audio\\-report|pvoc\\-stretch|apply\\-filter|plot\\-windows|add\\-scatter|fig\\-options|resample\\-to|complex\\-mul|nmf\\-sources|master\\-gain|audio\\-close|play\\-buffer|ambi\\-decode|pan\\-azimuth|append\\-file|knn\\-predict|loop\\-buffer|ambi\\-render|spectrogram|ambi\\-encode|add\\-surface|set\\-control|add\\-subplot|audio\\-start|assert\\-near|standardize|dist\\-matrix|concat\\-list|udp\\-receive|ambi\\-rotate|write\\-lines|whisperize|magnitudes|streamable|file\\-lines|pvoc\\-pitch|audio\\-open|note\\->midi|pca\\-scores|ends\\-with\\?|audio\\-init|set\\-params|ambi\\-gains|set\\-option|set\\-yrange|stereo\\-add|plot\\-lines|techno\\-kit|arp\\-events|x\\-or\\-index|hrir\\-model|interleave|pat\\-events|audio\\-time|fig\\-layers|find\\-first|set\\-labels|osc\\-listen|audio\\-quit|csv\\-escape|wait\\-until|audio\\-stop|set\\-xrange|play\\-synth|pvoc\\-cross|trance\\-kit|dc\\-block\\-r|osc\\-encode|linreg\\-fit|house\\-kit|histogram|highshelf|mat\\-shape|file\\-size|transpose|add\\-image|fig\\-title|sort\\-list|partition|nmf\\-error|extension|voice\\-set|knn\\-model|map\\-range|mat\\-shift|list\\->mat|play\\-with|contains\\?|sometimes|set\\-param|live\\-loop|mat\\-zeros|write\\-wav|next\\-pow2|insert\\-at|mat\\-print|col\\-stack|pad\\-right|mat\\-round|lookahead|normalize|remove\\-at|write\\-csv|fmt\\-fixed|mat\\-scale|hrtf\\-load|find\\-file|play\\-file|vec\\->list|add\\-layer|dc\\-block|hz\\->midi|chord\\-ev|between\\?|sequence|subplots|identity|cepstrum|waveform|defined\\?|get\\-cols|save\\-png|princarg|synth\\-ev|car\\->pol|set\\-rate|fade\\-out|add\\-line|osc\\-send|blackman|ambi\\-add|autocorr|audio\\-sr|read\\-csv|basename|rad\\->deg|ev\\-thunk|resample|deg\\->rad|midi\\->hz|quantile|udp\\-send|linspace|supersaw|lowshelf|pol\\->car|segments|free\\-all|add\\-bars|mat\\-ones|mat\\-rand|fftshift|mat\\-diag|hadamard|bandpass|mat\\-mean|note\\-off|robotize|group\\-by|mat\\-fill|highpass|wait\\-for|accuracy|humanize|knn\\-test|get\\-rows|read\\-wav|spectrum|pad\\-left|binaural|reverse|set\\-amp|flatten|mat\\-vec|mat\\-add|plot\\-xy|mat\\-col|mat\\-div|play\\-ev|mat\\-mul|channel|mat\\-std|nearest|interp1|compose|elapsed|set\\-pan|mat\\-sub|fade\\-in|fmt\\-pct|scatter|linefit|control|oscbank|mat\\-row|play\\-at|lp\\-norm|mat\\-sum|ev\\-beat|denoise|sort\\-by|offbass|mat\\-set|vec\\-mat|mat\\-get|note\\-at|mat\\-str|eig\\-sym|exists\\?|lowpass|peak\\-eq|accents|mat\\-min|degrade|hamming|note\\-on|impulse|dirname|shuffle|mat\\-max|mat\\-map|surface|add\\-at!|replace|format|melody|max\\-of|min\\-of|assert|max\\-by|length|window|argmax|equal\\?|getenv|cumsum|setidx|vstack|filter|median|figure|synths|rumble|voices|getidx|argmin|kmeans|add\\-at|concat|append|unique|euclid|biquad|onsets|empty\\?|min\\-by|dist\\-p|reject|sum\\-by|hstack|hoover|remove|reduce|values|record|zscore|acf\\-f0|center|gather|chance|ev\\-dur|phases|repeat|write|serve|times|clock|swing|slice|chord|gater|tempo|reson|parse|shift|noise|stack|snare|stdev|tkick|hypot|riser|atan2|image|log10|count|fixed|istft|input|delay|drums|split|every|pan\\-n|notch|tstab|mkdir|range|zeros|solve|even\\?|sweep|tclap|upper|round|error|steps|tohat|ncols|print|outer|nrows|lower|sleep|synth|floor|trace|file\\?|pluck|diag|vars|kick|ohat|sqrt|last|dir\\?|prod|hrir|bars|mean|poly|exec|odd\\?|acos|sign|stft|any\\?|show|dist|plot|note|hpss|rand|stop|head|push|free|tanh|that|diff|asin|put!|has\\?|copy|all\\?|ramp|norm|keys|type|seed|drop|each|duck|pvoc|perc|list|adsr|find|hann|clip|take|rank|lerp|fast|join|clap|log2|undb|ceil|roll|read|ones|sine|sort|exit|trim|play|beat|atan|comb|acid|stab|corr|stat|ifft|conv|tpad|tail|cwd|osc|lcm|map|pad|get|rms|zcr|exp|lag|pop|str|max|pan|bpf|sin|log|now|sum|mix|arp|num|tan|knn|chr|pow|hfc|ord|abs|rev|min|sub|gcd|pat|hat|iir|sym|vec|eye|pca|zip|gen|mod|inv|put|cov|sig|opt|fft|det|nmf|dot|cos|zap|cat|ev|ls|db)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

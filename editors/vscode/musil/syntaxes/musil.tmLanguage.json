{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(normalize\\-peak\\-stereo|spectral\\-irregularity|envelope\\-from\\-values|pvoc\\-pitch\\-formant|magnitude\\-spectrum|synth\\-render\\-file|clear\\-sound\\-cache|spectral\\-decrease|spectral\\-kurtosis|spectral\\-skewness|nmf\\-separate\\-with|spectral\\-centroid|spectral\\-flatness|spectral\\-envelope|flatten\\-spectrum|linreg\\-residuals|train\\-test\\-split|kmeans\\-centroids|spectral\\-rolloff|scatter\\-clusters|db\\-sounds\\-folder|histogram\\-figure|schroeder\\-reverb|score\\-render\\-at|play\\-score\\-from|binaural\\-decode|instrument\\-rank|audio\\-init\\-with|nmf\\-learn\\-parts|knn\\-predict\\-one|spectral\\-moment|displayed\\-score|spectral\\-spread|impose\\-envelope|envelope\\-follow|onsets\\-adaptive|pca\\-eigenvalues|layout\\-channels|nmf\\-spectrogram|stft\\-magnitudes|normalize\\-peak|onsets\\-of\\-flux|max\\-re\\-weights|db\\-instruments|nmf\\-with\\-parts|linreg\\-predict|audio\\-channels|register\\-score|mat\\-print\\-with|spectral\\-morph|score\\-duration|pca\\-directions|audio\\-running\\?|score\\-play\\-now|play\\-file\\-with|spectrum\\-freqs|score\\-schedule|clear\\-controls|onset\\-strength|payload\\->event|pca\\-explained|median\\-filter|score\\-remove!|db\\-techniques|normalize\\-rms|gate\\-spectrum|score\\-reverb!|controls\\-list|add\\-intercept|note\\-duration|cluster\\-sizes|pvoc\\-formants|db\\-available\\?|moving\\-source|audio\\-devices|kmeans\\-labels|spectral\\-flux|control\\-value|count\\-substr|bind\\-control|stereo\\-scale|score\\-shift!|regex\\-match\\?|speaker\\-ring|synth\\-render|apply\\-filter|interactive\\?|db\\-available|score\\-events|starts\\-with\\?|local\\-maxima|wav\\-duration|assert\\-equal|fit\\-duration|plot\\-windows|resolve\\-path|audio\\-status|score\\-select|render\\-event|score\\-scale!|deinterleave|score\\-render|nmf\\-separate|princarg\\-deg|synth\\-params|pvoc\\-stretch|onset\\-refine|audio\\-report|add\\-scatter|db\\-features|add\\-subplot|ambi\\-rotate|resample\\-to|event\\-gain!|score\\-sort!|concerthall|concat\\-list|udp\\-receive|fig\\-options|add\\-surface|append\\-file|audio\\-close|event\\-lanes|dist\\-matrix|pitch\\->midi|score\\-print|ambi\\-render|set\\-control|knn\\-predict|loop\\-buffer|ambi\\-decode|score\\-merge|pan\\-azimuth|assert\\-near|write\\-lines|audio\\-start|midi\\->pitch|complex\\-mul|standardize|play\\-buffer|spectrogram|master\\-gain|nmf\\-sources|ambi\\-encode|db\\-dynamics|x\\-or\\-index|whisperize|ambi\\-gains|csv\\-escape|ends\\-with\\?|pca\\-scores|audio\\-stop|db\\-nearest|arp\\-events|audio\\-init|set\\-params|score\\-rows|plot\\-lines|audio\\-quit|set\\-labels|hrir\\-model|play\\-event|play\\-synth|fig\\-layers|osc\\-encode|score\\-roll|play\\-score|magnitudes|stop\\-score|interleave|file\\-lines|dc\\-block\\-r|linreg\\-fit|pvoc\\-pitch|db\\-between|db\\-pitches|pat\\-events|note\\->midi|pvoc\\-cross|directory\\?|wait\\-until|load\\-sound|find\\-first|instrument|audio\\-time|stereo\\-add|set\\-yrange|set\\-xrange|streamable|osc\\-listen|trance\\-kit|techno\\-kit|audio\\-open|set\\-option|normalize|extension|fmt\\-fixed|histogram|pad\\-right|fig\\-title|house\\-kit|knn\\-model|play\\-with|nmf\\-error|mat\\-shift|next\\-pow2|partition|col\\-stack|set\\-param|vec\\->list|write\\-csv|sometimes|mat\\-print|highshelf|playhead!|remove\\-at|voice\\-set|find\\-file|add\\-layer|db\\-locate|contains\\?|insert\\-at|mat\\-zeros|lookahead|live\\-loop|transpose|play\\-file|hrtf\\-load|file\\-size|roll\\-play|mat\\-scale|list\\->mat|mat\\-shape|mat\\-round|add\\-image|sort\\-list|write\\-wav|note\\-path|map\\-range|event\\-end|db\\-range|ev\\-thunk|get\\-rows|waveform|chord\\-ev|bandpass|blackman|mat\\-ones|free\\-all|dc\\-block|basename|read\\-wav|udp\\-send|mat\\-mean|db\\-merge|princarg|score\\-sr|fade\\-out|identity|synth\\-ev|wait\\-for|pad\\-left|lowshelf|robotize|mat\\-fill|save\\-png|hadamard|midi\\->hz|quantile|car\\->pol|note\\-off|subplots|get\\-cols|add\\-line|read\\-csv|resample|fftshift|set\\-rate|mat\\-rand|between\\?|event\\-at|pol\\->car|db\\-query|highpass|sequence|segments|accuracy|autocorr|supersaw|defined\\?|knn\\-test|ambi\\-add|humanize|audio\\-sr|deg\\->rad|rad\\->deg|hz\\->midi|add\\-bars|spectrum|osc\\-send|cepstrum|filename|group\\-by|mat\\-diag|linspace|binaural|control|lp\\-norm|scatter|to\\-rate|mat\\-str|exists\\?|display|mat\\-vec|vec\\-mat|mat\\-add|db\\-size|mat\\-set|hamming|surface|fade\\-in|fn\\-name|sort\\-by|flatten|mat\\-get|mat\\-sum|ev\\-beat|db\\-grep|peak\\-eq|offbass|db\\-make|note\\-on|lowpass|fmt\\-pct|set\\-amp|mat\\-sub|db\\-read|accents|channel|db\\-path|nearest|impulse|hall\\-ir|dirname|mat\\-std|add\\-at!|eig\\-sym|interp1|play\\-ev|converb|mat\\-mul|elapsed|replace|compose|note\\-at|plot\\-xy|linefit|set\\-pan|denoise|mat\\-map|mat\\-min|shuffle|db\\-load|mat\\-col|reverse|db\\-find|mat\\-row|degrade|mat\\-div|oscbank|play\\-at|mat\\-max|biquad|setidx|repeat|zscore|rumble|format|argmin|ev\\-dur|filter|figure|gather|window|getidx|unique|empty\\?|onsets|record|hoover|phases|voices|acf\\-f0|euclid|sum\\-by|reject|db\\-gen|remove|dist\\-p|concat|hstack|min\\-by|melody|getenv|max\\-of|reduce|length|equal\\?|values|argmax|append|vstack|cumsum|render|chance|max\\-by|add\\-at|center|synths|kmeans|assert|min\\-of|median|swing|slice|count|split|floor|event|every|trace|fixed|reson|tohat|log10|gater|upper|print|snare|solve|score|input|tkick|riser|pluck|place|hypot|shift|mkdir|tclap|tstab|even\\?|parse|drums|nrows|notch|error|range|zeros|ncols|outer|steps|write|serve|sleep|istft|delay|stdev|times|lower|chord|tempo|sweep|stack|noise|pan\\-n|clock|atan2|synth|round|image|file\\?|stat|ifft|exec|beat|trim|dist|ohat|adsr|pvoc|hrir|stft|any\\?|lerp|acid|corr|ramp|tail|duck|bars|poly|perc|that|norm|kick|sign|free|prod|has\\?|push|tanh|hpss|stab|ones|fast|ceil|find|clap|type|stop|plot|play|each|dir\\?|sine|sort|take|drop|odd\\?|clip|undb|last|mean|list|join|vars|call|conv|hann|note|copy|read|keys|head|diff|tpad|asin|acos|rand|exit|rank|comb|show|roll|sqrt|log2|put!|atan|all\\?|seed|diag|iir|sub|arp|zip|det|now|vec|num|map|zap|bpf|inv|cwd|osc|lcm|sum|put|tan|pow|get|sig|cos|gcd|chr|cat|ord|pad|pan|pop|pat|knn|pca|mix|eye|abs|rev|dot|sym|log|zcr|str|hat|opt|lag|max|hfc|cov|min|fft|exp|sin|nmf|gen|mod|rms|ls|ev|db)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

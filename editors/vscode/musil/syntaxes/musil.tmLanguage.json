{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-decrease|spectral\\-centroid|synth\\-render\\-file|spectral\\-kurtosis|spectral\\-flatness|spectral\\-envelope|spectral\\-skewness|kmeans\\-centroids|linreg\\-residuals|histogram\\-figure|spectral\\-rolloff|train\\-test\\-split|flatten\\-spectrum|schroeder\\-reverb|scatter\\-clusters|audio\\-init\\-with|spectral\\-moment|pca\\-eigenvalues|impose\\-envelope|envelope\\-follow|stft\\-magnitudes|spectral\\-spread|knn\\-predict\\-one|pca\\-directions|audio\\-channels|linreg\\-predict|onset\\-strength|clear\\-controls|spectral\\-morph|play\\-file\\-with|spectrum\\-freqs|audio\\-running\\?|mat\\-print\\-with|normalize\\-peak|kmeans\\-labels|audio\\-devices|cluster\\-sizes|pca\\-explained|median\\-filter|gate\\-spectrum|add\\-intercept|pvoc\\-formants|controls\\-list|control\\-value|spectral\\-flux|normalize\\-rms|synth\\-params|starts\\-with\\?|plot\\-windows|synth\\-render|apply\\-filter|wav\\-duration|deinterleave|assert\\-equal|audio\\-report|bind\\-control|onset\\-refine|count\\-substr|audio\\-status|local\\-maxima|pvoc\\-stretch|concat\\-list|knn\\-predict|loop\\-buffer|complex\\-mul|play\\-buffer|append\\-file|spectrogram|audio\\-start|add\\-surface|standardize|assert\\-near|fig\\-options|master\\-gain|udp\\-receive|add\\-subplot|write\\-lines|audio\\-close|add\\-scatter|resample\\-to|set\\-control|dist\\-matrix|set\\-option|set\\-params|pat\\-events|set\\-labels|linreg\\-fit|audio\\-time|interleave|ends\\-with\\?|audio\\-stop|audio\\-init|audio\\-open|trance\\-kit|note\\->midi|streamable|play\\-synth|magnitudes|fig\\-layers|plot\\-lines|whisperize|pca\\-scores|audio\\-quit|wait\\-until|dc\\-block\\-r|csv\\-escape|osc\\-listen|osc\\-encode|arp\\-events|pvoc\\-cross|x\\-or\\-index|techno\\-kit|set\\-yrange|set\\-xrange|file\\-lines|pvoc\\-pitch|mat\\-round|add\\-layer|mat\\-zeros|map\\-range|play\\-file|fmt\\-fixed|sort\\-list|add\\-image|live\\-loop|mat\\-shift|voice\\-set|pad\\-right|write\\-wav|highshelf|histogram|mat\\-print|write\\-csv|extension|col\\-stack|normalize|house\\-kit|lookahead|next\\-pow2|mat\\-shape|contains\\?|set\\-param|knn\\-model|file\\-size|sometimes|play\\-with|vec\\->list|mat\\-scale|list\\->mat|transpose|find\\-file|fig\\-title|highpass|read\\-wav|linspace|princarg|knn\\-test|humanize|udp\\-send|hadamard|between\\?|osc\\-send|dc\\-block|midi\\->hz|blackman|note\\-off|resample|bandpass|cepstrum|pad\\-left|ev\\-thunk|sequence|audio\\-sr|mat\\-mean|robotize|free\\-all|subplots|rad\\->deg|read\\-csv|chord\\-ev|accuracy|add\\-bars|add\\-line|save\\-png|spectrum|mat\\-diag|set\\-rate|deg\\->rad|hz\\->midi|basename|segments|mat\\-rand|synth\\-ev|quantile|defined\\?|fade\\-out|lowshelf|waveform|get\\-rows|get\\-cols|car\\->pol|wait\\-for|pol\\->car|supersaw|identity|mat\\-fill|mat\\-ones|fftshift|autocorr|add\\-at!|play\\-ev|oscbank|plot\\-xy|mat\\-vec|mat\\-std|offbass|vec\\-mat|degrade|mat\\-sub|hamming|elapsed|lp\\-norm|note\\-on|mat\\-add|mat\\-row|ev\\-beat|mat\\-get|play\\-at|shuffle|set\\-pan|dirname|set\\-amp|mat\\-col|compose|mat\\-str|interp1|nearest|flatten|peak\\-eq|mat\\-set|mat\\-mul|note\\-at|linefit|mat\\-map|eig\\-sym|exists\\?|control|accents|fade\\-in|surface|scatter|lowpass|impulse|denoise|reverse|fmt\\-pct|mat\\-sum|replace|hstack|equal\\?|min\\-of|median|setidx|append|onsets|remove|melody|ev\\-dur|max\\-of|concat|add\\-at|assert|chance|getenv|euclid|unique|getidx|figure|reduce|cumsum|kmeans|synths|vstack|hoover|filter|acf\\-f0|phases|center|length|empty\\?|zscore|repeat|biquad|voices|dist\\-p|rumble|argmin|gather|format|argmax|window|write|stdev|slice|range|floor|tstab|image|print|lower|swing|hypot|steps|noise|delay|tclap|notch|fixed|every|log10|times|even\\?|reson|riser|file\\?|upper|round|clock|parse|zeros|gater|shift|istft|snare|tkick|nrows|error|solve|split|tempo|synth|outer|drums|input|atan2|sleep|sweep|mkdir|tohat|count|chord|stack|trace|ncols|pluck|pvoc|odd\\?|ifft|lerp|log2|hann|duck|all\\?|last|tanh|join|ramp|copy|seed|show|diag|beat|stop|acid|each|corr|sign|undb|clip|type|sort|hpss|perc|clap|dist|rank|fast|rand|take|tpad|drop|list|stab|push|stat|ohat|norm|acos|sqrt|any\\?|sine|roll|kick|diff|find|free|stft|plot|head|that|exec|poly|prod|mean|trim|play|adsr|cons|bars|ones|vars|conv|exit|read|ceil|comb|note|asin|dir\\?|atan|tail|zap|cos|eye|pan|sum|zcr|max|map|mix|lag|gcd|sig|cat|abs|iir|opt|osc|sym|str|gen|tan|inv|lcm|pad|knn|zip|rms|pat|pca|now|rev|dot|arp|pop|hfc|fft|min|chr|vec|cov|hat|log|det|num|pow|bpf|ord|exp|mod|cwd|sub|sin|ev|db|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

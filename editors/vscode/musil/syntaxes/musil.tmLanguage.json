{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|normalize\\-peak\\-stereo|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-centroid|spectral\\-skewness|spectral\\-flatness|spectral\\-decrease|clear\\-sound\\-cache|spectral\\-kurtosis|nmf\\-separate\\-with|spectral\\-envelope|synth\\-render\\-file|schroeder\\-reverb|spectral\\-rolloff|scatter\\-clusters|flatten\\-spectrum|db\\-sounds\\-folder|linreg\\-residuals|kmeans\\-centroids|train\\-test\\-split|histogram\\-figure|stft\\-magnitudes|spectral\\-spread|instrument\\-rank|audio\\-init\\-with|pca\\-eigenvalues|onsets\\-adaptive|play\\-score\\-from|nmf\\-learn\\-parts|binaural\\-decode|nmf\\-spectrogram|knn\\-predict\\-one|impose\\-envelope|layout\\-channels|spectral\\-moment|envelope\\-follow|score\\-duration|payload\\->event|db\\-instruments|linreg\\-predict|audio\\-running\\?|normalize\\-peak|mat\\-print\\-with|nmf\\-with\\-parts|clear\\-controls|onset\\-strength|spectrum\\-freqs|score\\-schedule|spectral\\-morph|onsets\\-of\\-flux|max\\-re\\-weights|pca\\-directions|play\\-file\\-with|audio\\-channels|db\\-techniques|kmeans\\-labels|controls\\-list|spectral\\-flux|gate\\-spectrum|score\\-remove!|median\\-filter|db\\-available\\?|note\\-duration|control\\-value|add\\-intercept|audio\\-devices|moving\\-source|cluster\\-sizes|pca\\-explained|pvoc\\-formants|normalize\\-rms|score\\-shift!|wav\\-duration|starts\\-with\\?|render\\-event|score\\-scale!|bind\\-control|plot\\-windows|assert\\-equal|db\\-available|regex\\-match\\?|resolve\\-path|nmf\\-separate|interactive\\?|fit\\-duration|score\\-select|stereo\\-scale|audio\\-status|score\\-events|pvoc\\-stretch|synth\\-params|audio\\-report|deinterleave|apply\\-filter|princarg\\-deg|count\\-substr|local\\-maxima|speaker\\-ring|score\\-render|synth\\-render|onset\\-refine|complex\\-mul|score\\-print|db\\-dynamics|audio\\-start|db\\-features|add\\-surface|set\\-control|ambi\\-decode|midi\\->pitch|add\\-scatter|pan\\-azimuth|event\\-lanes|write\\-lines|resample\\-to|add\\-subplot|nmf\\-sources|ambi\\-encode|score\\-sort!|play\\-buffer|fig\\-options|ambi\\-render|standardize|append\\-file|assert\\-near|spectrogram|score\\-merge|pitch\\->midi|dist\\-matrix|knn\\-predict|master\\-gain|loop\\-buffer|event\\-gain!|ambi\\-rotate|udp\\-receive|concat\\-list|audio\\-close|plot\\-lines|streamable|fig\\-layers|file\\-lines|osc\\-listen|play\\-synth|techno\\-kit|pat\\-events|pvoc\\-cross|load\\-sound|arp\\-events|audio\\-quit|directory\\?|audio\\-open|set\\-yrange|set\\-xrange|score\\-roll|dc\\-block\\-r|note\\->midi|interleave|whisperize|audio\\-time|set\\-option|pvoc\\-pitch|csv\\-escape|db\\-nearest|magnitudes|linreg\\-fit|stereo\\-add|pca\\-scores|ambi\\-gains|set\\-labels|x\\-or\\-index|ends\\-with\\?|trance\\-kit|wait\\-until|set\\-params|audio\\-init|play\\-score|find\\-first|hrir\\-model|osc\\-encode|score\\-rows|db\\-pitches|db\\-between|audio\\-stop|instrument|set\\-param|col\\-stack|find\\-file|db\\-locate|extension|nmf\\-error|play\\-with|transpose|note\\-path|add\\-layer|live\\-loop|next\\-pow2|mat\\-print|highshelf|map\\-range|playhead!|mat\\-scale|normalize|vec\\->list|mat\\-zeros|write\\-csv|mat\\-shape|event\\-end|write\\-wav|knn\\-model|add\\-image|mat\\-round|mat\\-shift|remove\\-at|play\\-file|pad\\-right|sometimes|fmt\\-fixed|contains\\?|house\\-kit|partition|insert\\-at|fig\\-title|file\\-size|hrtf\\-load|histogram|sort\\-list|list\\->mat|voice\\-set|lookahead|add\\-line|sequence|hadamard|chord\\-ev|ambi\\-add|autocorr|midi\\->hz|accuracy|waveform|princarg|spectrum|set\\-rate|hz\\->midi|highpass|synth\\-ev|resample|segments|between\\?|db\\-merge|mat\\-fill|get\\-cols|mat\\-diag|db\\-range|binaural|humanize|supersaw|wait\\-for|mat\\-rand|linspace|basename|deg\\->rad|bandpass|rad\\->deg|note\\-off|udp\\-send|mat\\-mean|car\\->pol|quantile|audio\\-sr|mat\\-ones|group\\-by|event\\-at|filename|save\\-png|defined\\?|ev\\-thunk|free\\-all|identity|blackman|robotize|dc\\-block|get\\-rows|lowshelf|subplots|fftshift|read\\-wav|pad\\-left|cepstrum|fade\\-out|knn\\-test|score\\-sr|read\\-csv|db\\-query|pol\\->car|add\\-bars|osc\\-send|lp\\-norm|to\\-rate|accents|plot\\-xy|mat\\-map|offbass|mat\\-set|display|mat\\-vec|fade\\-in|peak\\-eq|exists\\?|db\\-make|note\\-on|eig\\-sym|compose|db\\-grep|reverse|linefit|replace|mat\\-std|ev\\-beat|set\\-pan|scatter|oscbank|impulse|vec\\-mat|degrade|mat\\-row|mat\\-sub|mat\\-max|channel|mat\\-get|interp1|db\\-find|db\\-size|hamming|dirname|shuffle|control|denoise|elapsed|mat\\-div|set\\-amp|db\\-read|flatten|note\\-at|fmt\\-pct|surface|sort\\-by|nearest|db\\-load|mat\\-col|mat\\-min|play\\-ev|mat\\-mul|fn\\-name|db\\-path|lowpass|mat\\-sum|play\\-at|mat\\-add|mat\\-str|add\\-at!|rumble|argmax|phases|hoover|synths|gather|length|remove|concat|max\\-of|min\\-by|setidx|dist\\-p|vstack|chance|cumsum|argmin|add\\-at|voices|center|values|ev\\-dur|format|filter|repeat|render|zscore|melody|assert|append|equal\\?|acf\\-f0|max\\-by|min\\-of|window|getidx|reject|getenv|sum\\-by|biquad|kmeans|db\\-gen|hstack|unique|euclid|reduce|record|onsets|figure|median|empty\\?|range|tohat|pan\\-n|tempo|pluck|atan2|stdev|sleep|nrows|shift|score|floor|snare|delay|gater|split|istft|chord|even\\?|image|solve|sweep|parse|notch|tclap|lower|drums|fixed|count|noise|trace|print|ncols|steps|zeros|input|outer|file\\?|slice|upper|times|error|write|tkick|place|synth|tstab|hypot|reson|round|riser|log10|stack|every|serve|mkdir|clock|event|swing|ramp|sine|hpss|tail|type|copy|take|exit|join|corr|roll|push|rank|dir\\?|has\\?|tpad|duck|stft|ones|tanh|that|each|sqrt|put!|list|poly|asin|bars|undb|seed|comb|hrir|find|any\\?|kick|call|all\\?|dist|conv|atan|last|clap|hann|head|mean|ifft|diag|keys|trim|odd\\?|stab|pvoc|exec|diff|sort|vars|stat|note|ceil|lerp|perc|acid|rand|clip|fast|play|prod|sign|show|ohat|plot|stop|free|norm|drop|acos|read|beat|log2|adsr|zip|cos|fft|get|num|pop|cat|eye|log|cov|gen|now|pca|lag|inv|exp|pad|put|hfc|sym|map|tan|opt|arp|zcr|nmf|ord|lcm|bpf|sig|iir|hat|pow|rev|gcd|max|mod|dot|min|knn|sub|chr|abs|zap|det|rms|osc|pat|vec|pan|str|cwd|mix|sin|sum|db|ls|ev)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

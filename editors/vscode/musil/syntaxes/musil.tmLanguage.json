{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|magnitude\\-spectrum|pvoc\\-pitch\\-formant|spectral\\-envelope|spectral\\-skewness|synth\\-render\\-file|spectral\\-centroid|spectral\\-kurtosis|spectral\\-flatness|spectral\\-decrease|flatten\\-spectrum|scatter\\-clusters|schroeder\\-reverb|histogram\\-figure|spectral\\-rolloff|train\\-test\\-split|kmeans\\-centroids|linreg\\-residuals|stft\\-magnitudes|knn\\-predict\\-one|audio\\-init\\-with|impose\\-envelope|spectral\\-spread|envelope\\-follow|spectral\\-moment|pca\\-eigenvalues|onsets\\-adaptive|spectral\\-morph|play\\-file\\-with|spectrum\\-freqs|audio\\-channels|onset\\-strength|normalize\\-peak|pca\\-directions|mat\\-print\\-with|clear\\-controls|onsets\\-of\\-flux|audio\\-running\\?|linreg\\-predict|cluster\\-sizes|kmeans\\-labels|spectral\\-flux|gate\\-spectrum|pca\\-explained|add\\-intercept|control\\-value|pvoc\\-formants|normalize\\-rms|controls\\-list|audio\\-devices|median\\-filter|count\\-substr|onset\\-refine|bind\\-control|audio\\-status|local\\-maxima|pvoc\\-stretch|interactive\\?|apply\\-filter|deinterleave|synth\\-render|wav\\-duration|starts\\-with\\?|audio\\-report|assert\\-equal|synth\\-params|plot\\-windows|concat\\-list|fig\\-options|dist\\-matrix|add\\-surface|audio\\-close|resample\\-to|knn\\-predict|master\\-gain|write\\-lines|set\\-control|udp\\-receive|complex\\-mul|play\\-buffer|add\\-subplot|add\\-scatter|loop\\-buffer|assert\\-near|append\\-file|standardize|audio\\-start|spectrogram|note\\->midi|plot\\-lines|csv\\-escape|trance\\-kit|audio\\-init|audio\\-time|interleave|audio\\-quit|pvoc\\-pitch|set\\-yrange|set\\-option|file\\-lines|pat\\-events|techno\\-kit|play\\-synth|set\\-xrange|fig\\-layers|audio\\-open|pvoc\\-cross|osc\\-encode|wait\\-until|set\\-labels|audio\\-stop|osc\\-listen|pca\\-scores|set\\-params|x\\-or\\-index|whisperize|arp\\-events|streamable|ends\\-with\\?|magnitudes|linreg\\-fit|dc\\-block\\-r|next\\-pow2|write\\-wav|normalize|transpose|fmt\\-fixed|write\\-csv|mat\\-print|sort\\-list|mat\\-zeros|lookahead|contains\\?|highshelf|histogram|mat\\-shift|map\\-range|play\\-with|add\\-layer|set\\-param|mat\\-round|play\\-file|find\\-file|vec\\->list|house\\-kit|extension|fig\\-title|list\\->mat|pad\\-right|file\\-size|voice\\-set|knn\\-model|sometimes|mat\\-shape|add\\-image|live\\-loop|mat\\-scale|col\\-stack|mat\\-diag|supersaw|sequence|segments|save\\-png|waveform|wait\\-for|highpass|hz\\->midi|quantile|add\\-bars|humanize|lowshelf|knn\\-test|read\\-csv|blackman|defined\\?|mat\\-rand|get\\-rows|accuracy|resample|deg\\->rad|get\\-cols|note\\-off|udp\\-send|robotize|synth\\-ev|mat\\-fill|chord\\-ev|linspace|free\\-all|basename|car\\->pol|between\\?|mat\\-mean|osc\\-send|read\\-wav|cepstrum|rad\\->deg|add\\-line|hadamard|dc\\-block|fade\\-out|set\\-rate|pad\\-left|pol\\->car|bandpass|ev\\-thunk|princarg|subplots|identity|mat\\-ones|autocorr|spectrum|audio\\-sr|fftshift|midi\\->hz|oscbank|flatten|linefit|nearest|lp\\-norm|mat\\-add|interp1|mat\\-map|mat\\-set|play\\-ev|mat\\-col|note\\-at|impulse|peak\\-eq|eig\\-sym|plot\\-xy|ev\\-beat|mat\\-mul|mat\\-sum|add\\-at!|mat\\-str|mat\\-vec|hamming|accents|shuffle|mat\\-row|set\\-amp|dirname|surface|mat\\-get|offbass|degrade|fade\\-in|exists\\?|play\\-at|note\\-on|mat\\-std|elapsed|compose|vec\\-mat|control|lowpass|set\\-pan|scatter|replace|reverse|denoise|mat\\-sub|fmt\\-pct|concat|format|melody|setidx|median|reduce|filter|zscore|unique|add\\-at|kmeans|rumble|synths|repeat|max\\-of|phases|euclid|min\\-of|acf\\-f0|argmin|length|center|cumsum|ev\\-dur|remove|hstack|getenv|append|dist\\-p|onsets|voices|hoover|biquad|equal\\?|chance|empty\\?|vstack|assert|figure|getidx|argmax|window|gather|stack|snare|istft|upper|slice|atan2|ncols|stdev|log10|floor|tohat|trace|tempo|delay|shift|notch|parse|synth|mkdir|split|reson|print|gater|tclap|file\\?|error|fixed|drums|noise|nrows|zeros|range|pluck|input|steps|riser|times|write|outer|tkick|lower|solve|every|sleep|swing|even\\?|clock|chord|sweep|round|image|tstab|count|hypot|sign|poly|clap|show|conv|sine|diag|take|prod|stop|drop|dist|log2|all\\?|sqrt|tpad|each|duck|vars|find|free|ohat|atan|perc|join|stat|play|note|tail|lerp|mean|undb|corr|last|acos|roll|sort|cons|plot|trim|comb|clip|rank|stft|hann|exit|read|ceil|exec|type|seed|odd\\?|asin|ifft|head|any\\?|ones|tanh|kick|acid|that|ramp|push|stab|pvoc|norm|copy|adsr|beat|diff|hpss|bars|fast|rand|dir\\?|list|gcd|knn|pad|max|sig|cos|opt|hat|pow|min|iir|pop|sym|eye|pan|map|gen|pca|ord|mod|zap|fft|bpf|arp|sum|osc|sin|mix|chr|now|tan|rev|zip|zcr|det|log|vec|lcm|sub|lag|cat|str|rms|pat|inv|abs|hfc|cwd|exp|dot|num|cov|db|ls|ev)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

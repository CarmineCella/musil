{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(spectral\\-irregularity|envelope\\-from\\-values|pvoc\\-pitch\\-formant|magnitude\\-spectrum|spectral\\-kurtosis|synth\\-render\\-file|spectral\\-envelope|spectral\\-flatness|spectral\\-skewness|spectral\\-centroid|spectral\\-decrease|kmeans\\-centroids|linreg\\-residuals|train\\-test\\-split|spectral\\-rolloff|scatter\\-clusters|schroeder\\-reverb|histogram\\-figure|flatten\\-spectrum|pca\\-eigenvalues|spectral\\-spread|stft\\-magnitudes|envelope\\-follow|impose\\-envelope|knn\\-predict\\-one|spectral\\-moment|audio\\-init\\-with|audio\\-running\\?|audio\\-channels|normalize\\-peak|clear\\-controls|spectrum\\-freqs|pca\\-directions|spectral\\-morph|mat\\-print\\-with|linreg\\-predict|play\\-file\\-with|cluster\\-sizes|kmeans\\-labels|pca\\-explained|add\\-intercept|pvoc\\-formants|audio\\-devices|gate\\-spectrum|median\\-filter|normalize\\-rms|control\\-value|controls\\-list|spectral\\-flux|assert\\-equal|wav\\-duration|local\\-maxima|apply\\-filter|audio\\-report|starts\\-with\\?|audio\\-status|synth\\-render|count\\-substr|pvoc\\-stretch|plot\\-windows|deinterleave|bind\\-control|synth\\-params|spectrogram|set\\-control|add\\-scatter|append\\-file|knn\\-predict|write\\-lines|standardize|concat\\-list|assert\\-near|fig\\-options|master\\-gain|add\\-subplot|resample\\-to|loop\\-buffer|dist\\-matrix|udp\\-receive|audio\\-start|complex\\-mul|play\\-buffer|audio\\-close|add\\-surface|wait\\-until|set\\-labels|set\\-option|pvoc\\-pitch|set\\-yrange|set\\-xrange|csv\\-escape|linreg\\-fit|osc\\-listen|magnitudes|audio\\-quit|audio\\-init|interleave|fig\\-layers|whisperize|streamable|file\\-lines|audio\\-time|set\\-params|x\\-or\\-index|ends\\-with\\?|play\\-synth|dc\\-block\\-r|pca\\-scores|audio\\-stop|plot\\-lines|audio\\-open|pvoc\\-cross|find\\-file|play\\-file|play\\-with|normalize|fmt\\-fixed|map\\-range|sort\\-list|transpose|knn\\-model|set\\-param|lookahead|list\\->mat|voice\\-set|pad\\-right|mat\\-round|histogram|contains\\?|extension|file\\-size|mat\\-print|mat\\-scale|next\\-pow2|add\\-image|mat\\-shift|write\\-wav|highshelf|col\\-stack|fig\\-title|mat\\-zeros|live\\-loop|add\\-layer|mat\\-shape|vec\\->list|write\\-csv|mat\\-ones|fftshift|mat\\-mean|knn\\-test|mat\\-rand|fade\\-out|save\\-png|add\\-bars|add\\-line|between\\?|basename|read\\-csv|read\\-wav|sequence|hadamard|ev\\-thunk|car\\->pol|wait\\-for|lowshelf|get\\-cols|robotize|get\\-rows|identity|quantile|linspace|rad\\->deg|spectrum|resample|accuracy|highpass|cepstrum|bandpass|mat\\-diag|osc\\-send|subplots|synth\\-ev|udp\\-send|set\\-rate|pol\\->car|deg\\->rad|pad\\-left|waveform|blackman|dc\\-block|mat\\-fill|defined\\?|autocorr|note\\-off|audio\\-sr|princarg|free\\-all|degrade|interp1|scatter|shuffle|fade\\-in|surface|oscbank|play\\-ev|compose|mat\\-row|set\\-pan|add\\-at!|hamming|vec\\-mat|flatten|mat\\-add|note\\-at|lowpass|denoise|set\\-amp|mat\\-col|lp\\-norm|mat\\-vec|dirname|play\\-at|mat\\-get|mat\\-mul|elapsed|linefit|exists\\?|reverse|mat\\-str|mat\\-std|plot\\-xy|fmt\\-pct|replace|impulse|eig\\-sym|mat\\-map|note\\-on|peak\\-eq|nearest|mat\\-sub|mat\\-sum|mat\\-set|control|ev\\-beat|repeat|acf\\-f0|figure|setidx|empty\\?|append|unique|median|concat|zscore|reduce|gather|equal\\?|voices|length|argmax|remove|getenv|window|min\\-of|hstack|argmin|getidx|center|ev\\-dur|cumsum|add\\-at|kmeans|filter|dist\\-p|format|vstack|biquad|phases|max\\-of|assert|synths|atan2|split|nrows|times|print|hypot|stack|tempo|upper|round|floor|log10|write|fixed|even\\?|outer|shift|file\\?|mkdir|stdev|steps|range|reson|input|lower|delay|count|istft|trace|slice|ncols|error|image|solve|every|notch|noise|sleep|zeros|synth|clock|fast|all\\?|rank|sort|odd\\?|ramp|head|play|diag|note|dir\\?|log2|rand|asin|dist|conv|bars|vars|read|sign|stft|hann|clip|sine|beat|comb|corr|exit|undb|show|atan|adsr|trim|find|type|push|lerp|list|acos|mean|copy|free|prod|take|norm|any\\?|drop|join|seed|ifft|stat|diff|stop|pvoc|last|cons|ceil|sqrt|each|ones|exec|plot|tail|cos|opt|exp|osc|rev|sin|pan|map|max|lcm|knn|str|fft|cat|abs|mod|gen|vec|pca|now|ord|mix|bpf|sum|dot|lag|iir|eye|cwd|inv|gcd|log|rms|pow|num|zcr|hfc|chr|tan|pop|cov|det|zip|min|sym|ev|db|ls)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}

{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Musil",
  "scopeName": "source.musil",
  "patterns": [
    {
      "name": "comment.line.number-sign.musil",
      "match": "#.*$"
    },
    {
      "name": "string.quoted.double.musil",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.musil",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.musil",
      "match": "(?<![A-Za-z0-9\\-])-?[0-9]+(\\.[0-9]+)?([eE][-+]?[0-9]+)?(?![A-Za-z0-9\\-])"
    },
    {
      "name": "constant.language.musil",
      "match": "(?<![A-Za-z0-9\\-])(nil|true|false|pi|inf|tau|euler|version)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.control.musil",
      "match": "(?<![A-Za-z0-9\\-])(var|set|function|return|if|while|for|break|continue|try|catch|do|quote|expr|eval|apply|load|help|and|or|not)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "entity.name.function.musil",
      "match": "(?<=function\\s)[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "variable.other.constant.musil",
      "match": "'[A-Za-z][A-Za-z0-9\\-?!>]*"
    },
    {
      "name": "support.function.musil",
      "match": "(?<![A-Za-z0-9\\-?!>])(normalize\\-peak\\-stereo|spectral\\-irregularity|envelope\\-from\\-values|pvoc\\-pitch\\-formant|magnitude\\-spectrum|spectral\\-skewness|spectral\\-envelope|spectral\\-kurtosis|nmf\\-separate\\-with|clear\\-sound\\-cache|spectral\\-flatness|spectral\\-decrease|synth\\-render\\-file|spectral\\-centroid|linreg\\-residuals|schroeder\\-reverb|db\\-sounds\\-folder|kmeans\\-centroids|scatter\\-clusters|flatten\\-spectrum|histogram\\-figure|train\\-test\\-split|spectral\\-rolloff|pca\\-eigenvalues|play\\-score\\-from|binaural\\-decode|knn\\-predict\\-one|spectral\\-spread|impose\\-envelope|nmf\\-spectrogram|audio\\-init\\-with|layout\\-channels|stft\\-magnitudes|spectral\\-moment|envelope\\-follow|onsets\\-adaptive|displayed\\-score|nmf\\-learn\\-parts|instrument\\-rank|linreg\\-predict|onset\\-strength|max\\-re\\-weights|clear\\-controls|play\\-file\\-with|audio\\-channels|register\\-score|score\\-duration|score\\-schedule|nmf\\-with\\-parts|db\\-instruments|payload\\->event|audio\\-running\\?|pca\\-directions|normalize\\-peak|spectrum\\-freqs|onsets\\-of\\-flux|spectral\\-morph|mat\\-print\\-with|pvoc\\-formants|kmeans\\-labels|moving\\-source|control\\-value|controls\\-list|score\\-remove!|normalize\\-rms|audio\\-devices|spectral\\-flux|gate\\-spectrum|pca\\-explained|note\\-duration|add\\-intercept|cluster\\-sizes|median\\-filter|db\\-available\\?|db\\-techniques|wav\\-duration|score\\-select|plot\\-windows|nmf\\-separate|speaker\\-ring|starts\\-with\\?|audio\\-status|render\\-event|assert\\-equal|local\\-maxima|onset\\-refine|score\\-render|score\\-events|score\\-shift!|deinterleave|princarg\\-deg|audio\\-report|fit\\-duration|resolve\\-path|db\\-available|synth\\-render|score\\-scale!|regex\\-match\\?|bind\\-control|apply\\-filter|synth\\-params|stereo\\-scale|count\\-substr|interactive\\?|pvoc\\-stretch|pitch\\->midi|loop\\-buffer|score\\-sort!|db\\-dynamics|dist\\-matrix|append\\-file|complex\\-mul|audio\\-start|event\\-gain!|resample\\-to|ambi\\-render|concat\\-list|add\\-subplot|event\\-lanes|midi\\->pitch|db\\-features|play\\-buffer|set\\-control|nmf\\-sources|ambi\\-encode|audio\\-close|master\\-gain|score\\-print|ambi\\-decode|pan\\-azimuth|ambi\\-rotate|assert\\-near|fig\\-options|knn\\-predict|add\\-surface|add\\-scatter|score\\-merge|standardize|spectrogram|udp\\-receive|write\\-lines|linreg\\-fit|play\\-score|csv\\-escape|play\\-synth|play\\-event|techno\\-kit|note\\->midi|db\\-pitches|audio\\-open|ends\\-with\\?|pvoc\\-cross|instrument|load\\-sound|score\\-roll|directory\\?|set\\-yrange|x\\-or\\-index|db\\-nearest|set\\-labels|wait\\-until|plot\\-lines|audio\\-time|set\\-params|stereo\\-add|set\\-xrange|db\\-between|find\\-first|pvoc\\-pitch|interleave|dc\\-block\\-r|streamable|audio\\-init|trance\\-kit|whisperize|ambi\\-gains|arp\\-events|fig\\-layers|pca\\-scores|audio\\-quit|osc\\-encode|osc\\-listen|audio\\-stop|magnitudes|score\\-rows|hrir\\-model|file\\-lines|set\\-option|pat\\-events|house\\-kit|db\\-locate|play\\-file|contains\\?|add\\-image|mat\\-shift|add\\-layer|lookahead|write\\-wav|histogram|set\\-param|mat\\-scale|write\\-csv|sometimes|mat\\-round|pad\\-right|note\\-path|insert\\-at|map\\-range|mat\\-print|vec\\->list|remove\\-at|live\\-loop|sort\\-list|next\\-pow2|playhead!|play\\-with|hrtf\\-load|list\\->mat|voice\\-set|normalize|mat\\-shape|transpose|partition|knn\\-model|event\\-end|mat\\-zeros|nmf\\-error|fig\\-title|col\\-stack|find\\-file|extension|file\\-size|fmt\\-fixed|highshelf|basename|bandpass|car\\->pol|supersaw|between\\?|defined\\?|robotize|knn\\-test|cepstrum|read\\-csv|hz\\->midi|waveform|dc\\-block|add\\-bars|ambi\\-add|fftshift|db\\-range|group\\-by|save\\-png|get\\-rows|midi\\->hz|rad\\->deg|sequence|pad\\-left|accuracy|free\\-all|read\\-wav|pol\\->car|synth\\-ev|autocorr|chord\\-ev|mat\\-mean|add\\-line|subplots|identity|spectrum|resample|linspace|set\\-rate|quantile|fade\\-out|mat\\-ones|db\\-query|hadamard|audio\\-sr|mat\\-diag|mat\\-fill|get\\-cols|event\\-at|ev\\-thunk|lowshelf|score\\-sr|segments|osc\\-send|mat\\-rand|humanize|note\\-off|highpass|princarg|filename|blackman|binaural|deg\\->rad|udp\\-send|wait\\-for|db\\-merge|db\\-load|lowpass|mat\\-max|mat\\-get|mat\\-add|nearest|db\\-path|impulse|mat\\-div|mat\\-mul|compose|display|oscbank|eig\\-sym|mat\\-sub|db\\-read|to\\-rate|mat\\-vec|replace|interp1|degrade|linefit|db\\-make|scatter|reverse|flatten|play\\-ev|mat\\-set|denoise|mat\\-col|sort\\-by|fmt\\-pct|mat\\-map|set\\-pan|control|mat\\-std|exists\\?|db\\-grep|shuffle|peak\\-eq|add\\-at!|db\\-size|offbass|note\\-on|hamming|mat\\-sum|accents|mat\\-min|mat\\-row|channel|plot\\-xy|db\\-find|play\\-at|mat\\-str|lp\\-norm|dirname|fn\\-name|vec\\-mat|set\\-amp|elapsed|surface|ev\\-beat|note\\-at|fade\\-in|synths|vstack|cumsum|median|dist\\-p|length|append|euclid|melody|reduce|acf\\-f0|concat|assert|max\\-of|reject|remove|sum\\-by|min\\-of|values|hoover|format|ev\\-dur|filter|figure|add\\-at|getenv|biquad|gather|unique|argmax|equal\\?|max\\-by|setidx|phases|record|min\\-by|db\\-gen|chance|zscore|getidx|empty\\?|repeat|onsets|kmeans|window|argmin|hstack|voices|rumble|render|center|riser|range|shift|fixed|reson|place|noise|file\\?|steps|lower|log10|zeros|split|print|write|trace|image|nrows|stdev|istft|tohat|notch|atan2|tkick|even\\?|drums|event|delay|input|ncols|slice|solve|gater|error|tclap|floor|stack|pluck|chord|tempo|hypot|count|parse|sleep|round|clock|score|times|sweep|upper|serve|swing|synth|every|pan\\-n|tstab|snare|outer|mkdir|type|note|beat|call|dist|push|lerp|keys|hrir|poly|trim|any\\?|stab|ones|roll|show|dir\\?|hpss|ceil|pvoc|tail|drop|log2|adsr|stft|that|prod|hann|join|corr|head|seed|ohat|kick|has\\?|mean|tanh|conv|stat|atan|exit|acos|last|all\\?|read|sine|rank|sqrt|ifft|copy|bars|list|vars|clap|tpad|each|norm|take|play|put!|plot|sort|clip|rand|undb|asin|perc|find|diff|exec|fast|acid|duck|free|sign|comb|stop|ramp|odd\\?|diag|sin|pop|num|arp|cwd|pad|dot|str|zip|mod|lag|iir|inv|pca|eye|pat|log|vec|get|lcm|hfc|map|zap|zcr|sum|tan|nmf|ord|osc|pow|hat|sub|opt|fft|put|max|sym|knn|sig|gcd|pan|cov|gen|abs|exp|cat|rms|bpf|rev|det|cos|chr|min|mix|now|ls|db|ev)(?![A-Za-z0-9\\-?!>])"
    },
    {
      "name": "keyword.operator.musil",
      "match": "(?<=[\\s(])([-+*/]|<=|>=|==|!=|<|>|&&|\\|\\|)(?=[\\s)])"
    }
  ]
}
